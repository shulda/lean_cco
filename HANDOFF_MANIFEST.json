      "imports": [
        {
          "id": "I01",
          "name": "lem:typed-exact-products",
          "source_label": "lem:typed-exact-products",
          "statement": "Original tagged strong exact menus contain all singleton atoms and Top, are closed under converse, compatible products and meets with NONEMPTY RESULT. Use actual triangle semantics, SAP associativity/monotonicity and Top absorption from the same strong algebra. No RAW identity. Composition by every nonempty exact factor distributes over finite exact meets with NONEMPTY EVALUATION.",
          "status": "HUMAN_EXPANDED_NOT_LEAN",
          "provider_module": "strong_selectors"
        },
        {
          "id": "I02",
          "name": "thm:typed-HS",
          "source_label": "thm:typed-HS",
          "statement": "One conservative converse-compatible original joint selector preserving ALL THREE PC coordinates and survivor heredity. NR2/CCO are used to produce this provider, not repeated premises of the conditional SIR constructor.",
          "status": "HUMAN_EXPANDED_NOT_LEAN",
          "provider_module": "strong_selectors"
        },
        {
          "id": "I03",
          "name": "lem:cco-triangle-fullness",
          "source_label": "lem:cco-triangle-fullness",
          "statement": "An actual finite complete binary diagram whose induced subdiagrams on at most three vertices lie in a hereditary AP+semantic-CCO age lies in that age. The same fan proof preserves named sorts. The source snapshot and short support proof are included.",
          "status": "HUMAN_SUPPORT_PROOF_NOT_LEAN",
          "provider_module": null
        },
        {
          "id": "I04",
          "name": "thm:full-relative-Hasse",
          "source_label": "thm:full-relative-Hasse",
          "statement": "In the actual original one-sort transitive homogeneous finite complete symmetric binary CCO source, every finite-relative-index cover in the FULL invariant-equivalence lattice has index two. SAP and exactness are not required. Its proof is a separate upstream obligation, not expanded here. Consequently every finite relative index is a power of two.",
          "status": "EXPLICIT_UPSTREAM_NOT_EXPANDED",
          "provider_module": null
        }
      ],
      "proof_status": "HUMAN_PROOF_EXPANDED_NOT_LEAN"
    }
