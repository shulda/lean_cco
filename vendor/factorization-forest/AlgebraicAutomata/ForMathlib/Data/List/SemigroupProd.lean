module

public import Mathlib.Algebra.Group.Subsemigroup.Basic
public import Mathlib.Data.List.Basic

/-!
# Non-empty List Product in Semigroups

Product of a non-empty list of elements in a bare semigroup `S` (without identity `1`).

## References

* [T. Colcombet, *The Factorization Forest Theorem*][colcombet2008]
-/

@[expose] public section

namespace List

variable {S : Type*} [Semigroup S]

-- TODO: Upstream to Mathlib.Data.List.SemigroupProd
/-- Product of a non-empty list of elements in a semigroup `S`. -/
def prodNE : (u : List S) → u ≠ [] → S
  | [], hu => nomatch (hu rfl)
  | a :: rest, _ => rest.foldl (· * ·) a

/-- Alias for `prodNE` for backward compatibility within `List`. -/
abbrev listProdNE := @prodNE

-- TODO: Upstream to Mathlib.Data.List.SemigroupProd
/-- In a semigroup, `foldl (*)` pulls out a left multiplier unconditionally. -/
lemma foldl_mul (l : List S) (x y : S) :
    l.foldl (· * ·) (x * y) = x * l.foldl (· * ·) y := by
  induction l generalizing y with
  | nil => rfl
  | cons a rest ih =>
    simp only [List.foldl]
    rw [mul_assoc, ih]

-- TODO: Upstream to Mathlib.Data.List.SemigroupProd
/-- `List.foldl` multiplication by `x` on the left equals `x * prodNE v hv`. -/
lemma foldl_mul_eq_mul_prodNE (x : S) (v : List S) (hv : v ≠ []) :
    v.foldl (· * ·) x = x * prodNE v hv := by
  cases v with
  | nil => contradiction
  | cons a rest =>
    dsimp [prodNE]
    exact foldl_mul rest x a

/-- Alias for `foldl_mul_eq_mul_prodNE` for backward compatibility within `List`. -/
abbrev foldl_mul_eq_mul_listProdNE := @foldl_mul_eq_mul_prodNE

-- TODO: Upstream to Mathlib.Data.List.SemigroupProd
/-- Product of concatenated non-empty lists is the product of their individual products. -/
lemma prodNE_concat (u v : List S) (hu : u ≠ []) (hv : v ≠ []) :
    prodNE (u ++ v) (by simp [hu, hv]) = prodNE u hu * prodNE v hv := by
  cases u with
  | nil => contradiction
  | cons a rest =>
    dsimp [prodNE]
    rw [List.foldl_append]
    exact foldl_mul_eq_mul_prodNE (rest.foldl (· * ·) a) v hv

/-- Alias for `prodNE_concat` for backward compatibility within `List`. -/
abbrev listProdNE_concat := @prodNE_concat

-- TODO: Upstream to Mathlib.Data.List.SemigroupProd
/-- Every element in `Subsemigroup.closure X` is generated by
a non-empty list of elements in `X`. -/
lemma mem_closure_iff_exists_list (X : Set S) (s : S) :
    s ∈ Subsemigroup.closure X ↔
    ∃ (u : List S) (hu : u ≠ []), (∀ x ∈ u, x ∈ X) ∧ prodNE u hu = s := by
  constructor
  · intro hs
    induction hs using Subsemigroup.closure_induction with
    | mem x hx =>
      exact ⟨[x], by simp, by simp [hx], rfl⟩
    | mul x y hx hy ihx ihy =>
      rcases ihx with ⟨ux, hux, hX_x, rfl⟩
      rcases ihy with ⟨uy, huy, hX_y, rfl⟩
      exact ⟨ux ++ uy, by simp [hux, huy], List.forall_mem_append.mpr ⟨hX_x, hX_y⟩,
        prodNE_concat ux uy hux huy⟩
  · rintro ⟨u, hu, hX, rfl⟩
    induction u with
    | nil => contradiction
    | cons a rest ih =>
      cases rest with
      | nil => exact Subsemigroup.subset_closure (hX a (.head _))
      | cons b rest' =>
        have h_rest_ne : b :: rest' ≠ [] := by simp
        have ha := Subsemigroup.subset_closure (hX a (.head _))
        have ih' := ih h_rest_ne (fun x hx ↦ hX x (.tail _ hx))
        have h_eq : prodNE (a :: b :: rest') hu = a * prodNE (b :: rest') h_rest_ne :=
          foldl_mul_eq_mul_prodNE a (b :: rest') h_rest_ne
        rw [h_eq]
        exact Subsemigroup.mul_mem _ ha ih'

-- TODO: Upstream to Mathlib.Data.List.SemigroupProd
/-- Well-definedness of `prodNE` with respect to list equality. -/
lemma prodNE_eq (u v : List S) (hu : u ≠ []) (hv : v ≠ []) (h : u = v) :
    prodNE u hu = prodNE v hv :=
  h ▸ rfl

/-- Alias for `prodNE_eq` for backward compatibility within `List`. -/
abbrev listProdNE_eq := @prodNE_eq

end List

abbrev listProdNE := @List.prodNE
abbrev foldl_mul := @List.foldl_mul
abbrev foldl_mul_eq_mul_listProdNE := @List.foldl_mul_eq_mul_prodNE
abbrev listProdNE_concat := @List.prodNE_concat
abbrev mem_closure_iff_exists_list := @List.mem_closure_iff_exists_list
abbrev listProdNE_eq := @List.prodNE_eq

end
