import CCO.ParityHasse.Relative.Exact
import CCO.ParityHasse.Relative.Algebra
import Mathlib.Order.OrderIsoNat

/-! K-relative powers, their actual finite-palette stabilization and exact
represented equivalence closure. Exponent zero is K, including all least-
exponent boundary cases. No Hasse theorem is used. -/
universe u v w t
namespace CCO.ParityHasse.Relative
open Original

section Relations
variable {A : Type v}
/-- Literal K at zero; positive powers are the ordinary represented powers. -/
def power (K : Setoid A) (R : Rel A) : Nat → Rel A
  | 0 => K
  | n+1 => mul (power K R n) R

@[simp] theorem power_zero (K : Setoid A) (R : Rel A) : power K R 0 = K := rfl
@[simp] theorem power_succ (K : Setoid A) (R : Rel A) (n : Nat) :
    power K R (n+1) = mul (power K R n) R := rfl

theorem power_bisaturated (K : Setoid A) (R : Rel A) (hR : Bisaturated K R) :
    ∀ n, Bisaturated K (power K R n)
  | 0 => bisaturated_self K
  | n+1 => (power_bisaturated K R hR n).mul hR

theorem power_one (K : Setoid A) (R : Rel A) (hR : Bisaturated K R) :
    power K R 1 = R := hR.1

theorem power_add (K : Setoid A) (R : Rel A) (hR : Bisaturated K R) (n m : Nat) :
    power K R (n+m) = mul (power K R n) (power K R m) := by
  induction m with
  | zero => simpa using (power_bisaturated K R hR n).2.symm
  | succ m ih => rw [Nat.add_succ, power_succ, ih, mul_assoc, ← power_succ]

theorem kernel_le_power (K : Setoid A) (R : Rel A) (hKR : K ≤ R) :
    ∀ n, K ≤ power K R n
  | 0 => le_rfl
  | n+1 => fun x y hxy => ⟨y,kernel_le_power K R hKR n x y hxy,hKR y y (K.refl y)⟩

theorem power_monotone (K : Setoid A) (R : Rel A) (hKR : K ≤ R) :
    Monotone (power K R) := by
  apply monotone_nat_of_le_succ
  intro n x y hxy
  exact ⟨y,hxy,hKR y y (K.refl y)⟩

theorem power_symmetric (K : Setoid A) (R : Rel A) (hs : ∀ x y, R x y → R y x)
    (hR : Bisaturated K R) : ∀ n x y, power K R n x y → power K R n y x := by
  intro n
  induction n with
  | zero => exact fun _ _ h => K.symm h
  | succ n ih =>
    rintro x y ⟨z,hxz,hzy⟩
    have h : mul R (power K R n) y x := ⟨z,hs z y hzy,ih x z hxz⟩
    have hc : mul R (power K R n) = mul (power K R n) R := by
      calc
        mul R (power K R n) = mul (power K R 1) (power K R n) := by rw [power_one K R hR]
        _ = power K R (1+n) := (power_add K R hR 1 n).symm
        _ = power K R (n+1) := by rw [Nat.add_comm]
        _ = mul (power K R n) R := rfl
    rw [hc] at h
    exact h

/-- The represented equivalence generated by all finite relative powers. -/
def closure (K : Setoid A) (R : Rel A) : Rel A := fun x y => ∃ n, power K R n x y

theorem kernel_le_closure (K : Setoid A) (R : Rel A) : K ≤ closure K R :=
  fun _ _ h => ⟨0,h⟩

theorem closure_equivalence (K : Setoid A) (R : Rel A) (hR : Bisaturated K R)
    (hs : ∀ x y, R x y → R y x) : Equivalence (closure K R) := by
  refine ⟨fun x => ⟨0,K.refl x⟩, ?_, ?_⟩
  · rintro x y ⟨n,h⟩; exact ⟨n,power_symmetric K R hs hR n x y h⟩
  · rintro x y z ⟨n,hxy⟩ ⟨m,hyz⟩
    refine ⟨n+m, ?_⟩
    rw [power_add K R hR]; exact ⟨y,hxy,hyz⟩

end Relations

variable {ι : Type u} {X : ι → Type v}
variable (S : AtomicSource.{u,v,w} ι X) {i : ι}
variable {G : Type t} [Group G] [∀ j : ι, MulAction G (X j)]
variable (H : HomogeneousSource S G)
variable (cco : SemanticCCO.{u,v,max u v,w} S)

include H in
theorem power_invariant (K : ColourEq S i) (R : Rel (X i))
    (hR : ColourInvariant S i R) : ∀ n, ColourInvariant S i (power K.val R n)
  | 0 => K.2
  | n+1 => colourInvariant_comp S H (power_invariant K R hR n) hR

include H cco in
theorem power_exact (K : ColourEq S i) (hK : Exact S K)
    (R : Rel (X i)) (hR : Exact S R) : ∀ n, Exact S (power K.val R n)
  | 0 => hK
  | n+1 => exact_comp S H cco (power_exact K hK R hR n) hR

/-- Finiteness here is the actual finite optional palette, not finite real carriers. -/
theorem finite_invariant_relations :
    Finite {R : Rel (X i) // ColourInvariant S i R} := by
  letI := S.finiteAtom i i
  apply Finite.of_injective (fun R : {R : Rel (X i) // ColourInvariant S i R} => S.rawSupport R.val)
  intro R T h
  change S.rawSupport R.val = S.rawSupport T.val at h
  apply Subtype.ext
  funext x y; apply propext
  constructor
  · intro hr
    have hc : S.colour x y ∈ S.rawSupport T.val := by rw [← h]; exact ⟨x,y,hr,rfl⟩
    obtain ⟨a,b,hab,hcol⟩ := hc
    exact (T.2 a b x y hcol).mp hab
  · intro ht
    have hc : S.colour x y ∈ S.rawSupport R.val := by rw [h]; exact ⟨x,y,ht,rfl⟩
    obtain ⟨a,b,hab,hcol⟩ := hc
    exact (R.2 a b x y hcol).mp hab

include H in
theorem closure_stabilizes (K : ColourEq S i) (R : Rel (X i))
    (hR : ColourInvariant S i R) (hKR : K ≤ R) :
    ∃ N, closure K.val R = power K.val R N ∧
      ∀ n, N ≤ n → power K.val R n = power K.val R N := by
  let C := {R : Rel (X i) // ColourInvariant S i R}
  letI : Finite C := finite_invariant_relations S
  let chain : Nat →o C :=
    { toFun := fun n => ⟨power K.val R n,power_invariant S H K R hR n⟩
      monotone' := power_monotone K.val R hKR }
  obtain ⟨N,hN⟩ := WellFoundedGT.monotone_chain_condition chain
  have stable (n : Nat) (hn : N ≤ n) : power K.val R n = power K.val R N :=
    (congrArg Subtype.val (hN n hn)).symm
  refine ⟨N, ?_, stable⟩
  funext x y; apply propext
  constructor
  · rintro ⟨n,hxy⟩
    by_cases hn : n ≤ N
    · exact power_monotone K.val R hKR hn _ _ hxy
    · rw [stable n (by omega)] at hxy; exact hxy
  · intro h; exact ⟨N,h⟩

include H cco in
theorem closure_exact (K : ColourEq S i) (hK : Exact S K)
    (R : Rel (X i)) (hR : Exact S R) (hKR : K ≤ R) : Exact S (closure K.val R) := by
  obtain ⟨N,hN,_⟩ := closure_stabilizes S H K R (hR.colourInvariant S H) hKR
  rw [hN]
  exact power_exact S H cco K hK R hR N

include H in
def closureEq (K : ColourEq S i) (R : Rel (X i))
    (hR : ColourInvariant S i R) (hSat : Bisaturated K.val R) : ColourEq S i :=
  ⟨⟨closure K.val R,closure_equivalence K.val R hSat (colourInvariant_symmetric S hR)⟩,
    by
      intro x y x' y' hc
      constructor <;> rintro ⟨n,hn⟩
      · exact ⟨n,(power_invariant S H K R hR n x y x' y' hc).mp hn⟩
      · exact ⟨n,(power_invariant S H K R hR n x y x' y' hc).mpr hn⟩⟩

end CCO.ParityHasse.Relative
