import CCO.UnarySupport.Omission

universe u v w
namespace CCO.UnarySupport.Structure
variable {L : Signature.{u}} {V : Type v} {W : Type w}
variable {C : Structure L V} {H : Structure L W}

namespace Hom

/-- Literal restriction of a map is an induced, domain-reflecting embedding. -/
def EmbeddingOn (f : Hom C H) (S : Set V) : Prop :=
  Set.InjOn f.point S ∧
  (∀ R xs, (∀ i, xs i ∈ S) → (H.rel R (f.point ∘ xs) ↔ C.rel R xs)) ∧
  (∀ F x, x ∈ S → ∀ y, y ∈ H.func F (f.point x) →
    ∃ z ∈ S, z ∈ C.func F x ∧ f.point z = y)

theorem embeddingOn_mono (f : Hom C H) {S T : Set V} (hS : C.IsClosed S)
    (hST : S ⊆ T) (hT : f.EmbeddingOn T) : f.EmbeddingOn S := by
  refine ⟨hT.1.mono hST, ?_, ?_⟩
  · intro R xs hxs
    exact hT.2.1 R xs (fun i => hST (hxs i))
  · intro F x hx y hy
    obtain ⟨z, _, hz, he⟩ := hT.2.2 F x (hST hx) y hy
    exact ⟨z, hS F x hx hz, hz, he⟩

def restrictionEmbedding (f : Hom C H) {S : Set V} (hS : C.IsClosed S)
    (hf : f.EmbeddingOn S) : Embedding (C.induce S hS) H where
  point x := f.point x.val
  sort_eq x := f.sort_eq x.val
  map_func F x y hy := f.map_func F x.val y.val hy
  map_rel R xs hx := f.map_rel R (Subtype.val ∘ xs) hx
  injective x y h := Subtype.ext (hf.1 x.property y.property h)
  reflect_func F x y hy := by
    obtain ⟨z, hzS, hz, he⟩ := hf.2.2 F x.val x.property y hy
    exact ⟨⟨z, hzS⟩, hz, he⟩
  reflect_rel R xs hx := (hf.2.1 R (Subtype.val ∘ xs) (fun i => (xs i).property)).1 hx

theorem embeddingOn_of_total (f : Hom C H) (hC : C.Total) {S : Set V}
    (hS : C.IsClosed S) (hinj : Set.InjOn f.point S)
    (href : ∀ R xs, (∀ i, xs i ∈ S) → H.rel R (f.point ∘ xs) → C.rel R xs) :
    f.EmbeddingOn S := by
  refine ⟨hinj, fun R xs hxs => ⟨href R xs hxs, f.map_rel R xs⟩, ?_⟩
  intro F x hx y hy
  have hsort : C.sort x = L.input F := by
    rw [← f.sort_eq x]
    exact (H.func_sorted F (f.point x) y hy).1
  obtain ⟨z, hz⟩ := hC F x hsort
  exact ⟨z, hS F x hx hz, hz, H.functional F (f.point x) (f.point z) y
    (f.map_func F x z hz) hy⟩

def LocallyInduced (f : Hom C H) : Prop := ∀ S, C.LocalSupport S → f.EmbeddingOn S

def NonemptyHomEmbedding (f : Hom C H) : Prop :=
  ∀ S (hS : C.IsClosed S), S.Nonempty → (C.induce S hS).Irreducible → f.EmbeddingOn S

def HomEmbedding (f : Hom C H) : Prop :=
  ∀ S (hS : C.IsClosed S), (C.induce S hS).Irreducible → f.EmbeddingOn S

end Hom

theorem localSupport_induce_image {S : Set V} (hS : C.IsClosed S)
    {A : Set S} (hA : (C.induce S hS).LocalSupport A) :
    C.LocalSupport (Subtype.val '' A) := by
  cases hA with
  | singleton x =>
    have he : Subtype.val '' (C.induce S hS).closureAt x = C.closureAt x.val := by
      simpa only [closureAt, Set.image_singleton] using C.closure_induce_image hS {x}
    rw [he]
    exact .singleton x.val
  | binary R hR xs hr hd =>
    have he : Subtype.val '' (C.induce S hS).closure (Set.range xs) =
        C.closure (Set.range (Subtype.val ∘ xs)) := by
      rw [C.closure_induce_image hS, ← Set.range_comp]
    rw [he]
    exact .binary R hR (Subtype.val ∘ xs) hr (by
      obtain ⟨i, j, hij⟩ := hd
      exact ⟨i, j, fun h => hij (Subtype.ext h)⟩)

theorem local_support_ambient {S : Set V} (hS : C.IsClosed S)
    (x y : S) (hxy : x ≠ y) (hirr : (C.induce S hS).Irreducible)
    (hbin : ∀ R, L.arity R ≤ 2) :
    ∃ A, C.LocalSupport A ∧ A ⊆ S ∧ x.val ∈ A ∧ y.val ∈ A := by
  obtain ⟨A, hA, hx, hy⟩ := (C.induce S hS).pair_support hbin hirr x y hxy
  exact ⟨Subtype.val '' A, localSupport_induce_image hS hA,
    by rintro z ⟨t, _, rfl⟩; exact t.property, ⟨x, hx, rfl⟩, ⟨y, hy, rfl⟩⟩

namespace Hom

theorem local_injective (f : Hom C H) (hf : f.LocallyInduced)
    (hbin : ∀ R, L.arity R ≤ 2) {S : Set V} (hS : C.IsClosed S)
    (hirr : (C.induce S hS).Irreducible) : Set.InjOn f.point S := by
  intro x hx y hy he
  by_contra hxy
  obtain ⟨A, hA, _, hxA, hyA⟩ := local_support_ambient hS ⟨x, hx⟩ ⟨y, hy⟩
    (fun h => hxy (congrArg Subtype.val h)) hirr hbin
  exact hxy ((hf A hA).1 hxA hyA he)

theorem local_nullary (f : Hom C H) (hf : f.LocallyInduced) (x : V)
    (R : L.Rel) (hR : L.arity R = 0) (xs : Fin (L.arity R) → V) :
    H.rel R (f.point ∘ xs) ↔ C.rel R xs := by
  apply (hf (C.closureAt x) (.singleton x)).2.1 R xs
  intro i
  have hi := i.isLt
  omega

/-- Any reflected binary tuple may use a support generated by a DIFFERENT
relation; all symbols, unary predicates and diagonal tuples are reflected. -/
theorem local_relation_reflection (f : Hom C H) (hf : f.LocallyInduced)
    (hbin : ∀ R, L.arity R ≤ 2) {S : Set V} (hS : C.IsClosed S)
    (hne : S.Nonempty) (hirr : (C.induce S hS).Irreducible)
    (R : L.Rel) (xs : Fin (L.arity R) → V) (hxs : ∀ i, xs i ∈ S)
    (hr : H.rel R (f.point ∘ xs)) : C.rel R xs := by
  classical
  by_cases hd : ∃ i j, xs i ≠ xs j
  · obtain ⟨i, j, hij⟩ := hd
    obtain ⟨A, hA, _, hiA, hjA⟩ := local_support_ambient hS ⟨xs i, hxs i⟩ ⟨xs j, hxs j⟩
      (fun h => hij (congrArg Subtype.val h)) hirr hbin
    apply ((hf A hA).2.1 R xs ?_).1 hr
    · intro k
      have hk : k = i ∨ k = j := by
        have hne : i ≠ j := fun h => hij (congrArg xs h)
        have hi := i.isLt
        have hj := j.isLt
        have hk := k.isLt
        have hb := hbin R
        by_cases he : k.val = i.val
        · exact Or.inl (Fin.ext he)
        · right
          apply Fin.ext
          have hne' : i.val ≠ j.val := fun h => hne (Fin.ext h)
          omega
      rcases hk with rfl | rfl
      · exact hiA
      · exact hjA
  · by_cases hn : 0 < L.arity R
    · let i : Fin (L.arity R) := ⟨0, hn⟩
      apply ((hf (C.closureAt (xs i)) (.singleton (xs i))).2.1 R xs ?_).1 hr
      · intro j
        have he : xs j = xs i := by by_contra h; exact hd ⟨j, i, h⟩
        rw [he]
        exact C.mem_closureAt _
    · obtain ⟨x, _⟩ := hne
      exact (f.local_nullary hf x R (by omega) xs).1 hr

theorem locallyInduced_nonempty (f : Hom C H) (hC : C.Total)
    (hbin : ∀ R, L.arity R ≤ 2) (hf : f.LocallyInduced) : f.NonemptyHomEmbedding := by
  intro S hS hne hirr
  exact f.embeddingOn_of_total hC hS (f.local_injective hf hbin hS hirr)
    (f.local_relation_reflection hf hbin hS hne hirr)

end Hom
end CCO.UnarySupport.Structure
