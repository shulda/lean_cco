import CCO.FullCode.Consumer
import CCO.APRamseyReadout.TemplateBounds
import CCO.FullCode.Reconstruction
import CCO.FullCode.Naturality

/-! C13--C17: marked templates and ALL full-code embeddings.
These are the actual constructed FullCode maps. Every hidden function
domain/value and all same-root/cross-root codes are retained. This branch
uses no Ramsey, cofinality, EP or fine-colour recovery. The concrete
fixed-chart bindings below discharge normal forms on actual whole hosts. -/

universe u v w z a b c
namespace CCO.APRamseyReadout
open CCO.FullCode

variable {L : Language.{u}} {V : Type v} {W : Type w} {Z : Type z}
variable {C : Structure L V} {D : Structure L W} {E : Structure L Z}
variable {S : RootScheme L} {A : Type a} {B : Type b} {K : Type c}

/-- The literal quotient of defined marked presentations is the entire
generated template, including repeated values from different roots. -/
noncomputable def templatePresentationEquiv (N : NormalForms L) (O : Object C S A)
    (hC : N.Valid C) : Quotient (O.presentationSetoid N) ≃ O.support :=
  O.presentationQuotientEquiv N hC

theorem templatePresentation_coordinate (N : NormalForms L) (O : Object C S A)
    (hC : N.Valid C) (x : A) (j : Fin (S.arity (O.root x).tag)) :
    templatePresentationEquiv N O hC (O.coordinateClass N hC x j) =
      ⟨(O.root x).coordinate j,O.coordinate_mem_support x j⟩ :=
  O.quotient_coordinate N hC x j

/-- The source equation on ALL actual induced embedding maps, for
every host D. The host need not be generated by any of its valid roots. -/
noncomputable def templateEmbeddingEquiv (N : NormalForms L) (O : Object C S A)
    (hC : N.Valid C) (hD : N.Valid D) :
    Structure.Embedding (O.codeStructure N) ((Object.full D S).codeStructure N) ≃
      Structure.Embedding O.supportStructure D :=
  foundational_full_code_embeddings N O hC hD

/-- The extension on every marked coordinate is forced by the displayed
visible embedding, rather than by a newly chosen hidden realization. -/
theorem templateEmbedding_coordinate (N : NormalForms L) (O : Object C S A)
    (hC : N.Valid C) (hD : N.Valid D)
    (f : Structure.Embedding (O.codeStructure N) ((Object.full D S).codeStructure N))
    (x : A) (j : Fin (S.arity (O.root x).tag)) :
    (templateEmbeddingEquiv N O hC hD f).point
        ⟨(O.root x).coordinate j,O.coordinate_mem_support x j⟩ =
      (f.point x).coordinate (((Object.embeddingOfCode f).tag_eq x).symm ▸ j) := by
  exact (Object.embeddingOfCode f).extendPoint_coordinate hC hD x j

/-- Complete codes determine one and only one domain-reflecting hidden
extension of the SAME full visible map. -/
theorem template_embedding_unique (N : NormalForms L) (O : Object C S A)
    (hC : N.Valid C) (hD : N.Valid D)
    (f : Structure.Embedding (O.codeStructure N) ((Object.full D S).codeStructure N)) :
    ∃! g : Structure.Embedding O.supportStructure D,
      (Object.fromHidden N O g).asCodeEmbedding = f ∧
        ∀ F x, (D.func F (g.point x)).Nonempty ↔
          (O.supportStructure.func F x).Nonempty := by
  obtain ⟨g,hg,hDomain,hUnique⟩ := full_code_embedding_use N O hC hD f
  exact ⟨g,⟨hg,hDomain⟩,fun h hh => hUnique h hh.1⟩

/-- Equality of full marked codes reconstructs the entire hidden
structure on the marked support, including genuine partial functions. -/
theorem template_marked_reconstruction (N : NormalForms L)
    (O : Object C S A) (P : Object D S B) (hC : N.Valid C) (hD : N.Valid D)
    (f : Object.Embedding N O P) (surj : Function.Surjective f.point) :
    O.supportStructure = P.supportStructure.comapEquiv (f.supportEquiv hC hD surj) :=
  f.support_reconstructed hC hD surj

noncomputable def templateSupportMap (N : NormalForms L)
    (O : Object C S A) (P : Object D S B) (hC : N.Valid C) (hD : N.Valid D)
    (f : Structure.Embedding (O.codeStructure N) (P.codeStructure N)) :
    Structure.Embedding O.supportStructure P.supportStructure :=
  (Object.embeddingOfCode f).onSupport hC hD

theorem templateSupportMap_id (N : NormalForms L) (O : Object C S A) (hC : N.Valid C) :
    templateSupportMap N O O hC hC (Structure.Embedding.id (O.codeStructure N)) =
      Structure.Embedding.id O.supportStructure := by
  have he : Object.embeddingOfCode (Structure.Embedding.id (O.codeStructure N)) =
      Object.Embedding.id N O := Object.Embedding.ext (fun _ => rfl)
  change (Object.embeddingOfCode _).onSupport hC hC = _
  rw [he]
  exact Object.onSupport_id hC

theorem templateSupportMap_comp (N : NormalForms L)
    (O : Object C S A) (P : Object D S B) (Q : Object E S K)
    (hC : N.Valid C) (hD : N.Valid D) (hE : N.Valid E)
    (f : Structure.Embedding (O.codeStructure N) (P.codeStructure N))
    (g : Structure.Embedding (P.codeStructure N) (Q.codeStructure N)) :
    templateSupportMap N O Q hC hE (g.comp f) =
      (templateSupportMap N P Q hD hE g).comp (templateSupportMap N O P hC hD f) := by
  have he : Object.embeddingOfCode (g.comp f) =
      (Object.embeddingOfCode g).comp (Object.embeddingOfCode f) :=
    Object.Embedding.ext (fun _ => rfl)
  change (Object.embeddingOfCode _).onSupport hC hE = _
  rw [he]
  exact Object.onSupport_comp (Object.embeddingOfCode f) (Object.embeddingOfCode g) hC hD hE


universe p
section Actual
noncomputable section
variable (B₀ : CCO.CloneTupleGeometry.OwnerStage.{u,v,w}) (ht : B₀.Terminal)
variable (F : Charts.{u,v,w,p} B₀)

abbrev orderedTupleNormalForms : NormalForms (OrderedCoordinateLanguage B₀ ht) :=
  CCO.TerminalHiddenHN.orderedNormalForms (cloneSource B₀) (cloneHomogeneous B₀)
    (cloneSAP B₀) (fullCovers B₀ ht)

theorem orderedTupleNormalForms_valid_of_actualAge {V₀ : Type z}
    (C₀ : CCO.UnarySupport.Structure (Sig B₀ ht) V₀) [LinearOrder V₀]
    (hC : ActualAge B₀ ht C₀) :
    (orderedTupleNormalForms B₀ ht).Valid (OrderedCoordinateModel B₀ ht C₀) :=
  CCO.TerminalHiddenHN.orderedNormalForms_valid_of_actualAge
    (cloneSource B₀) (cloneHomogeneous B₀) (cloneSAP B₀) (fullCovers B₀ ht) C₀ hC

/-- Concrete source C17: ALL actual full-code maps correspond to ALL
hidden induced embeddings, on arbitrary whole actual ordered hosts.
No selected-root generation condition is imposed on the target. -/
def actual_template_embeddings {V₀ : Type z} {W₀ : Type b} {A₀ : Type a}
    (C₀ : CCO.UnarySupport.Structure (Sig B₀ ht) V₀)
    (D₀ : CCO.UnarySupport.Structure (Sig B₀ ht) W₀)
    [LinearOrder V₀] [LinearOrder W₀]
    (hC : ActualAge B₀ ht C₀) (hD : ActualAge B₀ ht D₀)
    (O : Object (OrderedCoordinateModel B₀ ht C₀) (orderedTupleScheme B₀ ht F) A₀) :
    Structure.Embedding (O.codeStructure (orderedTupleNormalForms B₀ ht))
        ((Object.full (OrderedCoordinateModel B₀ ht D₀)
          (orderedTupleScheme B₀ ht F)).codeStructure (orderedTupleNormalForms B₀ ht)) ≃
      Structure.Embedding O.supportStructure (OrderedCoordinateModel B₀ ht D₀) :=
  templateEmbeddingEquiv (orderedTupleNormalForms B₀ ht) O
    (orderedTupleNormalForms_valid_of_actualAge B₀ ht C₀ hC)
    (orderedTupleNormalForms_valid_of_actualAge B₀ ht D₀ hD)

/-- The concrete marked-presentation quotient reconstructs every
unary-generated point of the SAME actual ordered template. -/
def actual_template_presentations {V₀ : Type z} {A₀ : Type a}
    (C₀ : CCO.UnarySupport.Structure (Sig B₀ ht) V₀) [LinearOrder V₀]
    (hC : ActualAge B₀ ht C₀)
    (O : Object (OrderedCoordinateModel B₀ ht C₀) (orderedTupleScheme B₀ ht F) A₀) :
    Quotient (O.presentationSetoid (orderedTupleNormalForms B₀ ht)) ≃ O.support :=
  templatePresentationEquiv (orderedTupleNormalForms B₀ ht) O
    (orderedTupleNormalForms_valid_of_actualAge B₀ ht C₀ hC)

/-- The full visible map has a unique actual hidden extension and that
extension reflects every original partial function domain. -/
theorem actual_template_extension_unique {V₀ : Type z} {W₀ : Type b} {A₀ : Type a}
    (C₀ : CCO.UnarySupport.Structure (Sig B₀ ht) V₀)
    (D₀ : CCO.UnarySupport.Structure (Sig B₀ ht) W₀)
    [LinearOrder V₀] [LinearOrder W₀]
    (hC : ActualAge B₀ ht C₀) (hD : ActualAge B₀ ht D₀)
    (O : Object (OrderedCoordinateModel B₀ ht C₀) (orderedTupleScheme B₀ ht F) A₀)
    (f : Structure.Embedding (O.codeStructure (orderedTupleNormalForms B₀ ht))
        ((Object.full (OrderedCoordinateModel B₀ ht D₀)
          (orderedTupleScheme B₀ ht F)).codeStructure (orderedTupleNormalForms B₀ ht))) :
    ∃! g : Structure.Embedding O.supportStructure (OrderedCoordinateModel B₀ ht D₀),
      (Object.fromHidden (orderedTupleNormalForms B₀ ht) O g).asCodeEmbedding = f ∧
        ∀ Q x, ((OrderedCoordinateModel B₀ ht D₀).func Q (g.point x)).Nonempty ↔
          (O.supportStructure.func Q x).Nonempty :=
  template_embedding_unique (orderedTupleNormalForms B₀ ht) O
    (orderedTupleNormalForms_valid_of_actualAge B₀ ht C₀ hC)
    (orderedTupleNormalForms_valid_of_actualAge B₀ ht D₀ hD) f

end
end Actual

end CCO.APRamseyReadout
