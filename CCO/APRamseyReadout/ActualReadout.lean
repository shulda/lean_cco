import CCO.APRamseyReadout.ActualTupleSupport
import CCO.APRamseyReadout.ReasonableExpansion
import CCO.APRamseyReadout.ProperHiddenAge

/-! Concrete readout data for ANY terminal owner endpoint and ANY fixed
meet-K chart. The actual support, finite predicates and same-map
reasonableness are constructed before the Ramsey arrow is applied. -/

universe u v w p
namespace CCO.APRamseyReadout
open CCO.CloneTupleGeometry CCO.FullCode
noncomputable section
variable (B : OwnerStage.{u,v,w}) (ht : B.Terminal) (F : Charts.{u,v,w,p} B)

/-- The actual finite original-owner expansion, with ALL marked codes. -/
abbrev actualFullReadoutData :
    CCO.TerminalHiddenHN.RealExpansionData.{u,v,w,max u v w,max u v} B.source :=
  (actualTupleInterpretation B ht F).fullReadoutExpansion B.homogeneous

theorem actualFullReadoutData_reasonable : (actualFullReadoutData B ht F).Reasonable :=
  (actualTupleInterpretation B ht F).fullReadoutExpansion_reasonable B.homogeneous

theorem actualFullReadoutData_precompact (A : CCO.FiniteInduced (X := B.Point)) :
    Finite ((actualFullReadoutData B ht F).Expansion A) :=
  (actualFullReadoutData B ht F).finite_expansions A

/-- No transition term introduces a deleted clone-real vertex into the
support generated by these actual proper coordinates. -/
theorem actualTupleSupport_proper (A : CCO.FiniteInduced (X := B.Point))
    {x : Values B} (hx : x ∈ actualTupleSupport B ht F A) :
    ProperSort B ht ((Target B ht).sort x) := by
  apply (CoordinateTarget B ht).closure_minimal (proper_set_closed B ht (Target B ht)) _ hx
  rintro y ⟨a,j,rfl⟩
  change Fin (chartArity F a.val.1) at j
  change ProperSort B ht ((CoordinateTarget B ht).sort ((ownerRoot B ht F a.val).coordinate j))
  rw [(ownerRoot B ht F a.val).sorted j]
  trivial

/-- The exact raw partial source on the SAME generated support. -/
def actualTemplateRaw (A : CCO.FiniteInduced (X := B.Point)) :
    CCO.UnarySupport.Structure (Sig B ht) (actualTupleSupport B ht F A) :=
  (Target B ht).induce (actualTupleSupport B ht F A)
    ((CoordinateTarget B ht).isClosed_closure _)

theorem actualTemplateRaw_mem (A : CCO.FiniteInduced (X := B.Point)) :
    ActualAge B ht (actualTemplateRaw B ht F A) :=
  CCO.TerminalHiddenHN.actualAge_of_closed _ _ _ _ _
    (actualTupleSupport_finite B ht F A) _

theorem actualTemplateRaw_binary (A : CCO.FiniteInduced (X := B.Point)) :
    CoordinateModel B ht (actualTemplateRaw B ht F A) =
      (actualTupleInterpretation B ht F).supportStructure A :=
  CCO.TerminalHiddenHN.binaryStructure_induce _ _ (Target B ht) _ _

/-- Only the support is ordered. The ambient infinite hidden structure
and all deleted clone-real vertices receive no additional order. -/
def actualOrderedTemplate {A : CCO.FiniteInduced (X := B.Point)}
    (a : (actualFullReadoutData B ht F).Expansion A) :
    FiniteHidden (OrderedCoordinateLanguage B ht) where
  Carrier := actualTupleSupport B ht F A
  model := @OrderedCoordinateModel B ht _ (actualTemplateRaw B ht F A) a.order
  finite := (actualTupleSupport_finite B ht F A).to_subtype

theorem actualOrderedTemplate_mem {A : CCO.FiniteInduced (X := B.Point)}
    (a : (actualFullReadoutData B ht F).Expansion A) :
    ProperOrderedAge B ht (actualOrderedTemplate B ht F a) := by
  refine ⟨⟨actualTemplateRaw B ht F A,a.order,actualTemplateRaw_mem B ht F A,rfl⟩,?_⟩
  intro x
  exact actualTupleSupport_proper B ht F A x.property

/-- Only the relation proof changes when the same literal marked tuple
is viewed with the supplied order; its coordinates remain unchanged. -/
def actualOrderedRoot {A : CCO.FiniteInduced (X := B.Point)}
    (a : (actualFullReadoutData B ht F).Expansion A) :
    A.vertices → Root (actualOrderedTemplate B ht F a).model (orderedTupleScheme B ht F) :=
  fun x => {
    tag := (((actualTupleInterpretation B ht F).object A).markedRoot x).tag
    coordinate := (((actualTupleInterpretation B ht F).object A).markedRoot x).coordinate
    sorted j := (((actualTupleInterpretation B ht F).object A).markedRoot x).sorted j
    valid := by
      apply ((tupleScheme B ht F).delta _).eval_lift
        (coordinateOrderExpansion B ht) (actualOrderedTemplate B ht F a).model _ |>.mpr
      change ((tupleScheme B ht F).delta _).eval (CoordinateModel B ht (actualTemplateRaw B ht F A)) _
      rw [actualTemplateRaw_binary B ht F A]
      exact (((actualTupleInterpretation B ht F).object A).markedRoot x).valid }

theorem actualOrderedRoot_map {A : CCO.FiniteInduced (X := B.Point)}
    (a : (actualFullReadoutData B ht F).Expansion A) (x : A.vertices) :
    ((actualOrderedRoot B ht F a x).toOld (coordinateOrderExpansion B ht)).map
      (CCO.TerminalHiddenHN.binaryEmbedding (Sig B ht)
        (CCO.TerminalHiddenHN.sig_binary (cloneSource B) (cloneHomogeneous B)
          (cloneSAP B) (fullCovers B ht))
        ((Target B ht).inclusion (actualTupleSupport B ht F A)
          ((CoordinateTarget B ht).isClosed_closure _))) = ownerRoot B ht F x.val := by
  apply Root.ext_coordinates rfl
  intro j
  rfl

/-- Marked selected roots, in the actual finite ordered support. Their
set is not replaced by every compatible tuple of that support. -/
def actualOrderedObject {A : CCO.FiniteInduced (X := B.Point)}
    (a : (actualFullReadoutData B ht F).Expansion A) :
    Object (actualOrderedTemplate B ht F a).model (orderedTupleScheme B ht F) A.vertices where
  root := actualOrderedRoot B ht F a
  injective := by
    intro x y h
    apply Subtype.ext
    apply ownerRoot_injective B ht F
    have hh := congrArg (fun r => (r.toOld (coordinateOrderExpansion B ht)).map
      (CCO.TerminalHiddenHN.binaryEmbedding (Sig B ht)
        (CCO.TerminalHiddenHN.sig_binary (cloneSource B) (cloneHomogeneous B)
          (cloneSAP B) (fullCovers B ht))
        ((Target B ht).inclusion (actualTupleSupport B ht F A)
          ((CoordinateTarget B ht).isClosed_closure _)))) h
    exact (actualOrderedRoot_map B ht F a x).symm.trans
      (hh.trans (actualOrderedRoot_map B ht F a y))

end
end CCO.APRamseyReadout
