import CCO.Owners.Provider.Enlargement
import CCO.Owners.Provider.OrbitTrim
import Mathlib.Algebra.Group.Subgroup.Lattice

/-! C11 on the actual source: generate a FINITE subgroup inside Aut(D1),
trim its orbit of the entire-packet seed, and retain all selected actions.
The ambient group generated by their lifts is never asserted finite. -/
namespace CCO.Owners.Provider
open Product ParityHasse.Original RealHull.Geometry
variable {A G R : Type*} [Group G] [MulAction G A]
variable (S : AtomicSource Unit (fun _ => A)) (H : HomogeneousSource S G)

theorem trim_selected_actions (D₁ U : Set A) (finite₁ : D₁.Finite)
    (closed₁ : FullPacketClosed S H D₁) (incU : U ⊆ D₁)
    (closedU : FullPacketClosed S H U)
    (α : R → OrbitalAut G A (Subtype.val : D₁ → A)) :
    ∃ D : Set A, D.Finite ∧ ∃ inc : U ⊆ D,
      ∃ inside : D ⊆ D₁, FullPacketClosed S H D ∧
      ∃ θ : R → OrbitalAut G A (Subtype.val : D → A),
        (∀ r (x : D), ((θ r).val x).val =
          ((α r).val ⟨x.val,inside x.property⟩).val) ∧
        (∀ x : D, ∃ β : OrbitalAut G A (Subtype.val : D → A), (β.val x).val ∈ U) := by
  classical
  letI : Finite D₁ := finite₁.to_subtype
  let K : Subgroup (OrbitalAut G A (Subtype.val : D₁ → A)) :=
    Subgroup.closure (Set.range α)
  let seed : Set D₁ := {x | x.val ∈ U}
  let V := OrbitTrim.orbitClosure (K := K) seed
  let D : Set A := Subtype.val '' V
  have memD (x : D₁) : x.val ∈ D ↔ x ∈ V := by
    constructor
    · rintro ⟨y,hy,heq⟩
      exact (Subtype.ext heq : y = x) ▸ hy
    · intro hx; exact ⟨x,hx,rfl⟩
  have inside : D ⊆ D₁ := by
    rintro x ⟨y,_,rfl⟩
    exact y.property
  have inc : U ⊆ D := by
    intro x hx
    exact (memD ⟨x,incU hx⟩).mpr (OrbitTrim.seed_subset seed hx)
  have finiteD : D.Finite := (Set.toFinite V).image Subtype.val
  letI : Finite D := finiteD.to_subtype
  let F' : Setoid D₁ := Setoid.comap Subtype.val (RealClosure.Bounds.finitePacket S H).val
  have preserve : ∀ (k : K) x y, F' x y → F' (k • x) (k • y) := by
    intro k x y hxy
    exact (induced_packet_iff S H D₁ k.val x y).mpr hxy
  have closedSeed : ∀ x ∈ seed, ∀ y, F' x y → y ∈ seed := by
    intro x hx y hxy
    exact closedU x.val hx y.val hxy
  have closedD : FullPacketClosed S H D := by
    intro x hx y hxy
    let x' : D₁ := ⟨x,inside hx⟩
    have hy₁ : y ∈ D₁ := closed₁ x x'.property y hxy
    let y' : D₁ := ⟨y,hy₁⟩
    apply (memD y').mpr
    exact OrbitTrim.full_packets F' preserve seed closedSeed x'
      ((memD x').mp hx) y' hxy
  have mapsD (k : K) (x : D) :
      (k.val.val ⟨x.val,inside x.property⟩).val ∈ D := by
    exact (memD _).mpr (OrbitTrim.invariant seed k
      ((memD ⟨x.val,inside x.property⟩).mp x.property))
  let restriction (k : K) : OrbitalAut G A (Subtype.val : D → A) :=
    restrictInducedAut k.val inside (mapsD k)
  let chosen (r : R) : K := ⟨α r,Subgroup.subset_closure ⟨r,rfl⟩⟩
  let θ : R → OrbitalAut G A (Subtype.val : D → A) := fun r => restriction (chosen r)
  refine ⟨D,finiteD,inc,inside,closedD,θ,?_,?_⟩
  · intro r x
    rfl
  · intro x
    obtain ⟨k,hk⟩ := OrbitTrim.move_to_seed seed
      ((memD ⟨x.val,inside x.property⟩).mp x.property)
    exact ⟨restriction k,hk⟩

end CCO.Owners.Provider
