import Mathlib.GroupTheory.GroupAction.Defs
import Mathlib.Data.Set.Finite.Basic
import Mathlib.Data.Set.Finite.Range
import Mathlib.Basic.Finite.Prod

/-!
# Orbit trimming preserves whole packets

These statements concern actual sets and actions. Their source instance
uses the finite subgroup of automorphisms generated by the selected owner
requests; it does not replace that construction by an extra provider.
-/

namespace CCO.Owners.Provider.OrbitTrim

variable {K V : Type*} [Group K] [MulAction K V]

def orbitClosure (A : Set V) : Set V := {x | ∃ g : K, ∃ a ∈ A, g • a = x}

theorem seed_subset (A : Set V) : A ⊆ orbitClosure (K := K) A := by
  intro a ha
  exact ⟨1, a, ha, one_smul K a⟩

theorem invariant (A : Set V) (g : K) {x : V} (hx : x ∈ orbitClosure (K := K) A) :
    g • x ∈ orbitClosure (K := K) A := by
  obtain ⟨h, a, ha, rfl⟩ := hx
  exact ⟨g * h, a, ha, mul_smul g h a⟩

theorem smul_mem_iff (A : Set V) (g : K) (x : V) :
    g • x ∈ orbitClosure (K := K) A ↔ x ∈ orbitClosure (K := K) A := by
  constructor
  · intro hx
    simpa only [inv_smul_smul] using invariant A g⁻¹ hx
  · exact invariant A g

theorem finite [Finite K] (A : Set V) (hA : A.Finite) :
    (orbitClosure (K := K) A).Finite := by
  letI := hA.to_subtype
  let f : K × A → V := fun p => p.1 • p.2.val
  have h : orbitClosure (K := K) A = Set.range f := by
    ext x
    constructor
    · rintro ⟨g, a, ha, hga⟩
      exact ⟨(g, ⟨a, ha⟩), hga⟩
    · rintro ⟨⟨g, a⟩, hga⟩
      exact ⟨g, a.val, a.property, hga⟩
  rw [h]
  exact Set.finite_range f

/-- Every new point can be moved back into the original seed. -/
theorem move_to_seed (A : Set V) {x : V} (hx : x ∈ orbitClosure (K := K) A) :
    ∃ g : K, g • x ∈ A := by
  obtain ⟨g, a, ha, rfl⟩ := hx
  exact ⟨g⁻¹, by simpa only [inv_smul_smul] using ha⟩

/-- Invariance of the actual packet relation transports seed saturation
through each motion; no independent packet permutation is chosen. -/
theorem full_packets (F : Setoid V)
    (preserve : ∀ (g : K) x y, F x y → F (g • x) (g • y))
    (A : Set V) (closed : ∀ x ∈ A, ∀ y, F x y → y ∈ A) :
    ∀ x ∈ orbitClosure (K := K) A, ∀ y, F x y → y ∈ orbitClosure (K := K) A := by
  rintro x ⟨g, a, ha, rfl⟩ y hxy
  have h : F a (g⁻¹ • y) := by
    simpa only [inv_smul_smul] using preserve g⁻¹ (g • a) y hxy
  exact ⟨g, g⁻¹ • y, closed a ha _ h, smul_inv_smul g y⟩

end CCO.Owners.Provider.OrbitTrim
