import CCO.FinitePackets.Geometry.Basic
import CCO.RealHull.Canonical.PositiveEven
import CCO.PositiveWords
import CCO.RawExact.Presentations
import Mathlib.Data.Finset.Lattice.Fold

/-! The actual core is generated by the looped OLD diversity orbitals.
Its RAW word is constructed by a finite product. The empty product is the
literal empty word; only a nonidentity core is asserted to be positive. -/
universe v w t
namespace CCO.FinitePackets.Geometry
open CCO.ParityHasse.Original CCO.RealHull.Geometry CCO.RealHull.Canonical
variable {M : Type v} (S : AtomicSource.{0,v,w} Unit (fun _ => M))

def gammaEq (a : Atom S) : ColourEq S () := supportEquiv S (gamma S a)

theorem supportEquiv_le_iff (R : Support S) (E : ColourEq S ()) :
    supportEquiv S R ≤ E ↔ R.val ⊆ diversitySupport S E := by
  constructor
  · intro h a ha
    obtain ⟨x,y,hxy⟩ := colour_realized S (some a)
    have hR : supportEquiv S R x y := by
      change col S x y ∈ plus S R.val
      rw [hxy]
      exact (some_mem_plus S _ _).mpr ha
    exact ⟨x,y,h hR,hxy⟩
  · intro h x y hxy
    apply (mem_plus_diversitySupport S E x y).mp
    change col S x y ∈ plus S R.val at hxy
    cases hc : col S x y with
    | none => exact none_mem_plus S _
    | some a =>
      rw [hc] at hxy
      exact (some_mem_plus S _ _).mpr (h ((some_mem_plus S _ _).mp hxy))

theorem gamma_le_iff (a : Atom S) (E : ColourEq S ()) :
    gammaEq S a ≤ E ↔ AtomBelow S E a := by
  rw [gammaEq,supportEquiv_le_iff,atomBelow_iff_mem]
  exact ⟨fun h => h (subset_generated S {a} (Set.mem_singleton a)),
    fun h => generated_le S {a} (equivalenceSupport S E)
      (fun b hb => (Set.mem_singleton_iff.mp hb) ▸ h)⟩

def loopGenerators (J : ColourEq S ()) : Set (Atom S) :=
  {a | Looped S a ∧ AtomBelow S J a}

def core (J : ColourEq S ()) : ColourEq S () :=
  supportEquiv S (generatedSupport S (loopGenerators S J))

theorem core_le_iff (J E : ColourEq S ()) :
    core S J ≤ E ↔ ∀ a, Looped S a → AtomBelow S J a → AtomBelow S E a := by
  rw [core,supportEquiv_le_iff]
  constructor
  · intro h a ha hJ
    exact (atomBelow_iff_mem S E a).mpr
      (h (subset_generated S (loopGenerators S J) ⟨ha,hJ⟩))
  · intro h
    apply generated_le S (loopGenerators S J) (equivalenceSupport S E)
    rintro a ⟨ha,hJ⟩
    exact (atomBelow_iff_mem S E a).mp (h a ha hJ)

theorem core_le (J : ColourEq S ()) : core S J ≤ J :=
  (core_le_iff S J J).mpr (fun _ _ h => h)

theorem core_mono : Monotone (core S) := by
  intro J K hJK
  apply (core_le_iff S J (core S K)).mpr
  intro a ha hJ
  exact (atomBelow_iff_mem S (core S K) a).mpr (by
    rw [core,diversitySupport_supportEquiv]
    exact subset_generated S (loopGenerators S K) ⟨ha,atomBelow_mono S hJK hJ⟩)

theorem looped_atom_core {J : ColourEq S ()} {a : Atom S}
    (ha : Looped S a) (hJ : AtomBelow S J a) : AtomBelow S (core S J) a := by
  apply (atomBelow_iff_mem S (core S J) a).mpr
  rw [core,diversitySupport_supportEquiv]
  exact subset_generated S (loopGenerators S J) ⟨ha,hJ⟩

theorem core_eq_of_loopGenerators_eq {J K : ColourEq S ()}
    (h : loopGenerators S J = loopGenerators S K) : core S J = core S K := by
  simp only [core,h]

noncomputable def loopAtoms (J : ColourEq S ()) : Finset (Atom S) := by
  classical
  letI := S.finiteAtom () ()
  exact Finset.univ.filter (fun a => a ∈ loopGenerators S J)

@[simp] theorem mem_loopAtoms (J : ColourEq S ()) (a : Atom S) :
    a ∈ loopAtoms S J ↔ Looped S a ∧ AtomBelow S J a := by
  classical
  simp only [loopAtoms,Finset.mem_filter,Finset.mem_univ,true_and]
  rfl

variable {G : Type t} [Group G] [MulAction G M]
variable (H : HomogeneousSource S G)
include H

/-- The loop law puts the original generator in its even support.  Thus the
accepted positive EVEN representative really represents full Gamma here. -/
theorem looped_gamma_eq_even {a : Atom S} (ha : Looped S a) :
    gamma S a = evenSupport S a := by
  apply Subtype.ext
  apply Set.Subset.antisymm
  · apply generated_le S {a} (evenSupport S a)
    intro b hb
    subst b
    exact looped_mem_even S H ha (subset_generated S {a} (Set.mem_singleton a))
  · apply generated_le S (square S a) (gamma S a)
    intro b hb
    apply (some_mem_plus S _ _).mp
    apply (gamma S a).property
    exact prod_mono S
      (fun c hc => (Set.mem_singleton_iff.mp hc) ▸
        (some_mem_plus S _ a).mpr (subset_generated S {a} (Set.mem_singleton a)))
      (fun c hc => (Set.mem_singleton_iff.mp hc) ▸
        (some_mem_plus S _ a).mpr (subset_generated S {a} (Set.mem_singleton a))) hb

theorem looped_gamma_word {a : Atom S} (ha : Looped S a) :
    ∃ n, RawWord.relation S (positiveEvenWord S a n) = (gammaEq S a).val.r := by
  rw [gammaEq,looped_gamma_eq_even S H ha]
  exact exists_positive_even_word S H a

noncomputable def generatorJoin (s : Finset (Atom S)) : ColourEq S () :=
  letI := ColourEq.lattice S H (i := ())
  s.sup (gammaEq S)

theorem core_eq_generatorJoin (J : ColourEq S ()) :
    core S J = generatorJoin S H (loopAtoms S J) := by
  classical
  letI := ColourEq.lattice S H (i := ())
  apply le_antisymm
  · apply (core_le_iff S J _).mpr
    intro a ha hJ
    apply (gamma_le_iff S a _).mp
    exact Finset.le_sup ((mem_loopAtoms S J a).mpr ⟨ha,hJ⟩)
  · apply Finset.sup_le
    intro a ha
    exact (gamma_le_iff S a _).mpr
      (looped_atom_core S (mem_loopAtoms S J a |>.mp ha).1
        (mem_loopAtoms S J a |>.mp ha).2)

theorem generatorJoin_word (s : Finset (Atom S))
    (h : ∀ a ∈ s, Looped S a) :
    ∃ word : RawWord S () (), RawWord.relation S word = (generatorJoin S H s).val.r := by
  classical
  letI := ColourEq.lattice S H (i := ())
  induction s using Finset.induction_on with
  | empty => exact ⟨.nil (),rfl⟩
  | @insert a s has ih =>
    obtain ⟨n,hn⟩ := looped_gamma_word S H (h a (Finset.mem_insert_self a s))
    obtain ⟨word,hw⟩ := ih (fun b hb => h b (Finset.mem_insert_of_mem hb))
    refine ⟨RawWord.append S (positiveEvenWord S a n) word,?_⟩
    rw [RawWord.relation_append,hn,hw]
    have hj : generatorJoin S H (insert a s) = gammaEq S a ⊔ generatorJoin S H s :=
      Finset.sup_insert
    rw [hj]
    funext x y
    apply propext
    change (∃ z, gammaEq S a x z ∧ generatorJoin S H s z y) ↔ _
    exact (sup_relation_iff S H (gammaEq S a) (generatorJoin S H s) x y).symm

theorem core_word (J : ColourEq S ()) :
    ∃ word : RawWord S () (), RawWord.relation S word = (core S J).val.r := by
  rw [core_eq_generatorJoin S H]
  exact generatorJoin_word S H _ (fun a ha => ((mem_loopAtoms S J a).mp ha).1)

theorem empty_core_actual_empty_word (J : ColourEq S ()) (h : loopAtoms S J = ∅) :
    core S J = ⊥ ∧ RawWord.relation S (.nil ()) = (core S J).val.r := by
  have hc : core S J = ⊥ := by rw [core_eq_generatorJoin S H,h]; rfl
  exact ⟨hc,by rw [hc]; rfl⟩

theorem nonidentity_core_generators_nonempty (J : ColourEq S ()) (hJ : core S J ≠ ⊥) :
    (loopAtoms S J).Nonempty := by
  by_contra h
  exact hJ (empty_core_actual_empty_word S H J (Finset.not_nonempty_iff_eq_empty.mp h)).1

theorem nonidentity_core_positive (J : ColourEq S ()) (hJ : core S J ≠ ⊥) :
    ∃ word : PositiveWord S () (), PositiveWord.represented S word = (core S J).val.r := by
  obtain ⟨word,hword⟩ := core_word S H J
  rcases PositiveWord.raw_relation_identity_or_positive S word with h | ⟨p,hp⟩
  · exfalso
    apply hJ
    apply ColourEq.ext
    intro x y
    rw [← hword]
    change RawWord.relation S word x y ↔ x = y
    simpa only [Sigma.mk.injEq,heq_eq_eq,true_and] using h.2 x y
  · exact ⟨p,hp.symm.trans hword⟩

noncomputable def coreWord (J : ColourEq S ()) : RawWord S () () :=
  Classical.choose (core_word S H J)

theorem coreWord_relation (J : ColourEq S ()) :
    RawWord.relation S (coreWord S H J) = (core S J).val.r :=
  Classical.choose_spec (core_word S H J)

noncomputable def coreExact (J : ColourEq S ()) : RawExact.NonemptyExact S () () := by
  refine ⟨[coreWord S H J],?_⟩
  obtain ⟨x⟩ := S.nonemptySort ()
  refine ⟨x,x,?_⟩
  intro word hw
  have he : word = coreWord S H J := List.mem_singleton.mp hw
  subst word
  exact (coreWord_relation S H J).symm ▸ (core S J).val.refl x

theorem coreExact_represents (J : ColourEq S ()) :
    RawExact.evaluate S (coreExact S H J).words = (core S J).val.r := by
  funext x y
  apply propext
  change (∀ word ∈ [coreWord S H J], RawWord.relation S word x y) ↔ _
  simp only [List.mem_singleton,forall_eq,coreWord_relation S H J]

end CCO.FinitePackets.Geometry
