import CCO.FullCode.Presentations
import CCO.FullCode.ClosureTransport
import Mathlib.Data.Set.Finite.Lattice
import Mathlib.Data.Set.Finite.Range
import Mathlib.Data.Fintype.Pi

/-! Actual old-root normalization and finite cofinal root-generated hosts. -/

universe u v w a
namespace CCO.FullCode
variable {L : Language.{u}} {V : Type v} {W : Type w}

instance finiteRoot (C : Structure L V) (S : RootScheme L) [Finite V] :
    Finite (Root C S) := by
  classical
  let := Fintype.ofFinite V
  let := Fintype.ofFinite S.Tag
  apply Finite.of_injective (fun r : Root C S =>
    (⟨r.tag, r.coordinate⟩ : (t : S.Tag) × (Fin (S.arity t) → V)))
  intro r s h
  cases r with | mk rt rc rs rv =>
    cases s with | mk st sc ss sv =>
      have ht : rt = st := (Sigma.mk.inj h).1
      cases ht
      have hc : rc = sc := eq_of_heq (Sigma.mk.inj h).2
      cases hc
      rfl

/-- The ambient cofinality lemma needs normal forms only at coordinates of
actual valid roots, not at every arbitrary ambient input point. -/
def RootNormalFormsValid (N : NormalForms L) (C : Structure L V)
    (S : RootScheme L) : Prop :=
  ∀ (r : Root C S) (j : Fin (S.arity r.tag)) (t : L.Sorts)
    (q : Term L (S.coordinateSort r.tag j) t),
    q.eval C (r.coordinate j) =
      (N.form _ _ (N.normalize q)).eval C (r.coordinate j)

theorem rootNormalFormsValid_of_valid (N : NormalForms L) (C : Structure L V)
    (S : RootScheme L) (valid : N.Valid C) : RootNormalFormsValid N C S :=
  fun r j _ q => valid _ _ q _ (r.sorted j)

def RootGenerated (C : Structure L V) (S : RootScheme L) : Prop :=
  (Object.full C S).support = Set.univ

namespace Object
variable {C : Structure L V} {S : RootScheme L} {A : Type a}

/-- The actual generated support of any marked root object is fully
root-generated by roots on that SAME support.  No normal form or EP is used. -/
theorem support_rootGenerated (O : Object C S A) : RootGenerated O.supportStructure S := by
  apply Set.eq_univ_of_forall
  intro x
  have hx : x ∈ O.markedObject.support := by
    rw [O.support_generated]
    trivial
  exact O.supportStructure.closure_minimal
    (O.supportStructure.isClosed_closure (Object.full O.supportStructure S).coordinates)
    (by
      rintro y ⟨a, j, hj⟩
      exact O.supportStructure.subset_closure _ ⟨O.markedRoot a, j, hj⟩) hx

theorem support_finite (O : Object C S A) [Finite A]
    (N : NormalForms L) (hN : N.Valid C) : O.support.Finite := by
  have heq : O.support = ⋃ a, ⋃ p : Presentation N S, (O.root a).presentation N p := by
    ext x
    simp only [Set.mem_iUnion]
    exact O.mem_support_iff_presentation N hN x
  rw [heq]
  exact Set.finite_iUnion fun a => Set.finite_iUnion fun p =>
    ((O.root a).presentation_functional N p).finite

theorem support_finite_of_rootForms (O : Object C S A) [Finite A]
    (N : NormalForms L) (valid : RootNormalFormsValid N C S) : O.support.Finite := by
  have heq : O.support = ⋃ a, ⋃ p : Presentation N S, (O.root a).presentation N p := by
    ext x
    simp only [Set.mem_iUnion]
    constructor
    · rintro ⟨z, ⟨a, j, rfl⟩, hpath⟩
      obtain ⟨t, q, hq⟩ := Term.path_represented ((O.root a).sorted j) hpath
      exact ⟨a, ⟨⟨(O.root a).tag, j⟩, t, N.normalize q⟩,
        (O.root a).coordinate j, ⟨rfl, rfl⟩, (valid (O.root a) j t q) ▸ hq⟩
    · rintro ⟨a, p, hx⟩
      exact O.presentation_mem_support N a p hx
  rw [heq]
  exact Set.finite_iUnion fun a => Set.finite_iUnion fun p =>
    ((O.root a).presentation_functional N p).finite

end Object

/-- OLD functions alone are used, including when the eventual expansions
have extra functions. -/
def oldRootSupport (C : Structure L V) (S : RootScheme L) : Set V :=
  (Object.full C S).support

def oldRootStructure (C : Structure L V) (S : RootScheme L) :
    Structure L (oldRootSupport C S) := (Object.full C S).supportStructure

def oldRootInclusion (C : Structure L V) (S : RootScheme L) :
    Structure.Embedding (oldRootStructure C S) C :=
  C.inclusion (oldRootSupport C S) (C.isClosed_closure (Object.full C S).coordinates)

/-- C48: qf transport gives exactly the same valid literal root tuples
after old-root normalization, including empty and zero-coordinate cases. -/
def oldRootEquiv (C : Structure L V) (S : RootScheme L) :
    Root (oldRootStructure C S) S ≃ Root C S where
  toFun := Root.map (oldRootInclusion C S)
  invFun := (Object.full C S).markedRoot
  left_inv r := by
    apply Root.map_injective (oldRootInclusion C S)
    exact Root.map_restrict _ _ _
  right_inv r := Root.map_restrict _ _ _

theorem oldRootStructure_generated (C : Structure L V) (S : RootScheme L) :
    RootGenerated (oldRootStructure C S) S := (Object.full C S).support_rootGenerated

theorem oldRootSupport_finite (C : Structure L V) (S : RootScheme L) [Finite V] :
    (oldRootSupport C S).Finite := Set.toFinite _

/-- Every actual ambient point has a defined old term presentation on one
valid literal root.  The ambient structure need not be finite. -/
def RootCovered (C : Structure L V) (S : RootScheme L) : Prop :=
  ∀ x : V, ∃ (r : Root C S) (j : Fin (S.arity r.tag))
    (t : Term L (S.coordinateSort r.tag j) (C.sort x)),
    x ∈ t.eval C (r.coordinate j)

structure CofinalExtension (P : Structure L V) (S : RootScheme L)
    (D : Structure L W) where
  carrier : Set V
  finite : carrier.Finite
  closed : P.IsClosed carrier
  embedding : Structure.Embedding D (P.induce carrier closed)
  generated : RootGenerated (P.induce carrier closed) S

/-- C21--C25 / RC: finitely many chosen covering roots, all their coordinates,
and the genuine old unary closure construct ONE finite cofinal host. -/
noncomputable def cofinalExtensionRootForms (P : Structure L V) (S : RootScheme L)
    (N : NormalForms L) (hN : RootNormalFormsValid N P S) (cover : RootCovered P S)
    (D : Structure L W) [Finite W] (e : Structure.Embedding D P) :
    CofinalExtension P S D := by
  classical
  choose r j t ht using fun z : W => cover (e.point z)
  let chosen : Set (Root P S) := Set.range r
  letI : Finite chosen := (Set.finite_range r).to_subtype
  let O : Object P S chosen := ⟨Subtype.val, Subtype.val_injective⟩
  have hcontains : ∀ z : W, e.point z ∈ O.support := by
    intro z
    apply (t z).eval_mem_closure ?_ (ht z)
    exact O.coordinate_mem_support ⟨r z, ⟨z, rfl⟩⟩ (j z)
  refine ⟨O.support, O.support_finite_of_rootForms N hN, P.isClosed_closure O.coordinates, ?_,
    O.support_rootGenerated⟩
  refine {
    point := fun z => ⟨e.point z, hcontains z⟩
    injective := ?_
    sort_eq := e.sort_eq
    map_func := fun F x y h => e.map_func F x y h
    reflect_func := ?_
    unary_iff := e.unary_iff
    binary_iff := e.binary_iff
  }
  · intro x y h
    exact e.injective (congrArg Subtype.val h)
  · intro F x y hy
    obtain ⟨z, hz, heq⟩ := e.reflect_func F x y.val hy
    exact ⟨z, hz, Subtype.ext heq⟩

noncomputable def cofinalExtension (P : Structure L V) (S : RootScheme L)
    (N : NormalForms L) (hN : N.Valid P) (cover : RootCovered P S)
    (D : Structure L W) [Finite W] (e : Structure.Embedding D P) :
    CofinalExtension P S D :=
  cofinalExtensionRootForms P S N (rootNormalFormsValid_of_valid N P S hN) cover D e

end CCO.FullCode
