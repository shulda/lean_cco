import CCO.FullCode.ExpansionRoots
import CCO.FullCode.EmbeddingBijection

/-! C30: uniqueness on the SAME old carrier is derived from complete codes
and old root generation.  No hidden isomorphism is supplied as a premise. -/
universe u v a
namespace CCO.FullCode
variable {L L₀ L₁ : Language.{u}} {V : Type v}

namespace Object
variable {C : Structure L V} {S : RootScheme L} {A : Type a}

def totalSupportEmbedding (O : Object C S A) (generated : O.support = Set.univ) :
    Structure.Embedding C O.supportStructure where
  point x := ⟨x, by rw [generated]; trivial⟩
  injective := by intro x y h; exact congrArg Subtype.val h
  sort_eq _ := rfl
  map_func _ _ _ h := h
  reflect_func F x y hy := ⟨y.val, hy, Subtype.ext rfl⟩
  unary_iff _ _ := Iff.rfl
  binary_iff _ _ _ := Iff.rfl

end Object

namespace Structure.Embedding
variable {C : Structure L V}

/-- A whole old carrier generated by all valid root coordinates has no
nontrivial self-embedding fixing those coordinates. -/
theorem fixed_of_root_coordinates (f : Structure.Embedding C C) (S : RootScheme L)
    (generated : RootGenerated C S)
    (coordinates : ∀ r : Root C S, ∀ j, f.point (r.coordinate j) = r.coordinate j) :
    ∀ x, f.point x = x := by
  have closed : C.IsClosed {x | f.point x = x} := by
    intro F x hx y hy
    have hm := f.map_func F x y hy
    rw [hx] at hm
    exact C.functional F x (f.point y) y hm hy
  have contains : (Object.full C S).coordinates ⊆ {x | f.point x = x} := by
    rintro x ⟨r, j, rfl⟩
    exact coordinates r j
  intro x
  apply C.closure_minimal closed contains
  change x ∈ (Object.full C S).support
  rw [generated]
  trivial

end Structure.Embedding

namespace ExpansionOn
variable {ρ : LanguageExpansion L₀ L₁} {S : RootScheme L₀}
  {H₁ : FiniteHidden.{u,v} L₁ → Prop} {D : FiniteHidden.{u,v} L₀}

private theorem coordinate_of_equal_roots {r s : Root D.model S} (h : r = s)
    (j : Fin (S.arity r.tag)) :
    r.coordinate j = s.coordinate ((congrArg Root.tag h) ▸ j) := by
  cases h
  rfl

theorem rootObject_generated (b : ExpansionOn ρ.toReduct H₁ D)
    (generated : RootGenerated D.model S) : (b.rootObject ρ S).support = Set.univ := by
  apply Set.eq_univ_of_forall
  intro x
  change x ∈ b.model.closure (b.rootObject ρ S).coordinates
  rw [b.rootObject_coordinates]
  apply b.model.closure_reduct_subset ρ.toReduct (Object.full D.model S).coordinates
  rw [b.reduct_eq]
  change x ∈ (Object.full D.model S).support
  rw [generated]
  trivial

/-- Complete expanded code on every old root, with its literal fixed root
identification, determines every expanded relation and partial function on
the SAME old host.  Old generation fixes the extended map pointwise. -/
theorem unique_of_full_code (N : NormalForms L₁)
    (generated : RootGenerated D.model S)
    (b₁ b₂ : ExpansionOn ρ.toReduct H₁ D)
    (h₁ : N.Valid b₁.model) (h₂ : N.Valid b₂.model)
    (code : Object.Embedding N (b₁.rootObject ρ S) (b₂.rootObject ρ S))
    (point_id : ∀ r, code.point r = r) : b₁.model = b₂.model := by
  let O := b₁.rootObject ρ S
  let f : Structure.Embedding b₁.model b₂.model :=
    (code.extend h₁ h₂).comp (O.totalSupportEmbedding (b₁.rootObject_generated generated))
  let old : Structure.Embedding D.model D.model :=
    ((f.reduct ρ.toReduct).sourceCongr b₁.reduct_eq).targetCongr b₂.reduct_eq
  have fixed_coordinates : ∀ r : Root D.model S, ∀ j,
      old.point (r.coordinate j) = r.coordinate j := by
    intro r j
    have hc := code.extendPoint_coordinate h₁ h₂ r j
    change code.extendPoint h₁ ⟨r.coordinate j, _⟩ =
      (code.point r).coordinate ((code.tag_eq r).symm ▸ j) at hc
    change code.extendPoint h₁ ⟨r.coordinate j, _⟩ = r.coordinate j
    have he : (code.point r).coordinate ((code.tag_eq r).symm ▸ j) = r.coordinate j :=
      (coordinate_of_equal_roots (point_id r).symm j).symm
    exact hc.trans he
  have fixed_all := old.fixed_of_root_coordinates S generated fixed_coordinates
  exact f.source_eq_of_same_point (Structure.Embedding.id b₂.model) fixed_all

end ExpansionOn
end CCO.FullCode
