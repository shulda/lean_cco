import CCO.TransitionClosure.OriginalUnaryTermLanguage

/-!
# B049 source07 C38-C40: structural normalization of ALL original unary terms

For every actual finite term generated by true original identities,
full upward quotient maps and genuine canonical old RAW transitions,
we construct a single finite original normal pattern E<=J followed
by one canonical original-G transport R. Proof is by induction on
the independent term syntax, retaining exact source and target
FULL original equivalences and checking the actual semantic map
at every OLD representative edge.

The induction's step for a final upward map uses the full B040
interval pullback; its step for a transition uses the literal
old RAW product and exact B040 composite target, never
any arbitrary independent quotient chart. Neither old/hidden
SAP, quotient CCO, terminal NR2 nor a positive identity
edge is assumed in this full-invariant statement.
-/

universe u v w t

namespace CCO.TransitionClosure

variable {ι : Type u} {X : ι → Type v}
variable (S : AtomicSource.{u,v,w} ι X)
variable {G : Type t} [Group G] [∀ s : ι, MulAction G (X s)]

open CCO.ParityHasse.Original
open CCO.QuotientTransport

/-- Structural C38/C39 NORMALIZATION:
EVERY original unary term, of arbitrary finite length and
all genuinely compatible original sorts/full kernels, has
a finite normal-pattern witness N with the same EXACT
source E, EXACT target F and pointwise semantics on EVERY
actual original relation edge. The normal relation is a
real nonempty old-G invariant RAW relation, not a mere
formal word nor a hidden quotient orbital. -/
theorem OriginalOldUnaryWord.normal_relation
    (H : HomogeneousSource S G)
    {i j : ι} {E : ColourEq S i} {F : ColourEq S j}
    (w : OriginalOldUnaryWord S H i E j F) :
    ∃ N : OriginalCanonicalUnaryNormalDatum S (G := G) i j,
      N.val.1 = E ∧
      originalTransportTargetColourEq S H N.val.2.val.1
        (originalCanonicalRawTransitionDatum_transport S H N.val.2) = F ∧
      ∀ (x : X i) (y : X j),
        N.val.2.val.2.val.val x y →
          OriginalOldUnaryWord.eval S H w (Quotient.mk E.val x) =
            Quotient.mk F.val y := by
  induction w with
  | ident E =>
      refine ⟨originalCanonicalUnaryNormalDatum_ident S H E,
        rfl, originalCanonicalUnaryNormalDatum_ident_target S H E, ?_⟩
      intro x y hR
      change x = y at hR
      subst y
      rfl
  | up w hFL ih =>
      obtain ⟨N,hSource,hTarget,hEdge⟩ := ih
      have hFL' := hFL
      rw [← hTarget] at hFL'
      let N' := originalCanonicalUnaryNormalDatum_after_up S H N _ hFL'
      refine ⟨N', hSource,
        originalCanonicalUnaryNormalDatum_after_up_target S H N _ hFL', ?_⟩
      intro x y hR
      change N.val.2.val.2.val.val x y at hR
      change Quot.mapRight hFL
          (OriginalOldUnaryWord.eval S H w (Quotient.mk _ x)) =
        Quotient.mk _ y
      rw [hEdge x y hR]
      rfl
  | transition w Q U ih =>
      obtain ⟨N,hSource,hTarget,hEdge⟩ := ih
      let T := originalCanonicalRawTransitionDatum_transport S H N.val.2
      have hIso :
          originalColourEqAsInvEq S H
            (originalTransportTargetColourEq S H N.val.2.val.1 T) =
              T.target :=
        (originalFullColourEqInvEqOrderIso S H).apply_symm_apply T.target
      have hT : T.target = originalColourEqAsInvEq S H F := by
        rw [← hIso, hTarget]
      have U' : Transport T.target Q.val.val := by
        rw [hT]
        exact U
      let N' := originalCanonicalUnaryNormalDatum_after_transition S H N Q U'
      let T' := originalCanonicalRawTransitionDatum_transport S H N'.val.2
      have hTcomp : T' = T.composite U' :=
        Subsingleton.elim _ _
      have hCompTarget : T'.target = U'.target := by
        rw [hTcomp]
        exact T.composite_target U'
      have hUTarget : U'.target = U.target := by
        apply InvEq.ext
        intro z z'
        rw [U'.target_iff, U.target_iff, hT]
      have hNewTarget :
          originalTransportTargetColourEq S H N'.val.2.val.1 T' =
            originalTransportTargetColourEq S H F U := by
        apply ColourEq.ext
        intro z z'
        change T'.target z z' ↔ U.target z z'
        rw [hCompTarget,hUTarget]
      refine ⟨N',hSource,hNewTarget,?_⟩
      intro x z hR
      obtain ⟨y,hxy,hyz⟩ := hR
      change U.quotientEquiv
          (OriginalOldUnaryWord.eval S H w (Quotient.mk _ x)) =
        Quotient.mk _ z
      rw [hEdge x y hxy]
      exact U.quotientEquiv_edge hyz

end CCO.TransitionClosure
