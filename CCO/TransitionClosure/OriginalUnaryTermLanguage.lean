import CCO.TransitionClosure.OriginalUnaryNormalClosure
import CCO.TransitionClosure.OriginalIdentityTransport

/-!
# B049 source07 C38-C40: genuine mixed original unary term language

Syntax is freely generated by (a) identities on ACTUAL original full
quotient sorts, (b) ACTUAL old upward quotient projections, and
(c) canonical B040 transitions along nonempty original-G invariant
RAW relations. A transition's source is the preceding literal target
full kernel. Thus arbitrarily long, alternating, same- and mixed-sort
terms are admitted, not merely a finite menu of selected words.

The independent finite normal data are in OriginalFiniteUnaryNormals,
and the two normalization rewrite lemmas are in OriginalUnaryNormalClosure.
This module establishes the actual term language and a genuine initial
identity normal datum, including the logical old diagonal. It does not
equate syntactic finiteness with finiteness of semantic functions, invent
a positive STRONG identity edge, or assume quotient SAP/CCO.
-/

universe u v w t

namespace CCO.TransitionClosure

variable {ι : Type u} {X : ι → Type v}
variable (S : AtomicSource.{u,v,w} ι X)
variable {G : Type t} [Group G] [∀ s : ι, MulAction G (X s)]

open CCO.ParityHasse.Original
open CCO.QuotientTransport

/-- A REAL FULL original quotient term. There is no bound on term
length, and no assumption that distinct syntactic terms denote
distinct unary functions. Identity and up maps do not require
an invented positive atomic edge. Every transition uses its
actual preceding transported full quotient, not a fresh chart. -/
inductive OriginalOldUnaryWord
    (H : HomogeneousSource S G) :
    (i : ι) → ColourEq S i → (j : ι) → ColourEq S j →
      Type (max u v w t) where
  | ident (i : ι) (E : ColourEq S i) :
      OriginalOldUnaryWord H i E i E
  | up {i j : ι} {E : ColourEq S i} {F L : ColourEq S j}
      (w : OriginalOldUnaryWord H i E j F) (hFL : F ≤ L) :
      OriginalOldUnaryWord H i E j L
  | transition {i j k : ι} {E : ColourEq S i} {F : ColourEq S j}
      (w : OriginalOldUnaryWord H i E j F)
      (Q : OriginalNonemptyInvariantTypedRel (X := X) (G := G) j k)
      (U : Transport (originalColourEqAsInvEq S H F) Q.val.val) :
      OriginalOldUnaryWord H i E k
        (originalTransportTargetColourEq S H F U)

namespace OriginalOldUnaryWord

/-- The genuine interpretation on original quotient classes:
a term is evaluated by its actual B040 canonical quotient
bijections and actual quotient-upward maps. -/
noncomputable def eval
    (H : HomogeneousSource S G)
    {i j : ι} {E : ColourEq S i} {F : ColourEq S j} :
    OriginalOldUnaryWord S H i E j F →
      Quotient E.val → Quotient F.val
  | .ident _ _ => fun q => q
  | .up w hFL => fun q => Quot.mapRight hFL (eval H w q)
  | .transition w _ U => fun q => U.quotientEquiv (eval H w q)

/-- Unlike a word expression, its full semantic chart records the
source and target ORIGINAL FULL quotient relations as well as
the actually interpreted function. -/
noncomputable def function
    (H : HomogeneousSource S G)
    {i j : ι} {E : ColourEq S i} {F : ColourEq S j}
    (w : OriginalOldUnaryWord S H i E j F) :
    OriginalCanonicalRawTransitionFunction S i j :=
  ⟨E,F,eval S H w⟩

end OriginalOldUnaryWord

/-- A normal datum representing a literal identity term has
initial E=J and the *TRUE* old diagonal relation, which is
nonempty and invariant under the original G. This relation is
RAW and carries no fake positive STRONG identity factor. -/
noncomputable def originalCanonicalUnaryNormalDatum_ident
    (H : HomogeneousSource S G) {i : ι} (E : ColourEq S i) :
    OriginalCanonicalUnaryNormalDatum S (G := G) i i := by
  let R : OriginalNonemptyInvariantTypedRel (X := X) (G := G) i i :=
    originalNonemptyInvariantTypedRel_ident S i
  let D : OriginalCanonicalRawTransitionDatum S (G := G) i i :=
    ⟨⟨E,R⟩, by
      intro x z h
      obtain ⟨y,hxy,hzy⟩ := h
      change x = y at hxy
      change z = y at hzy
      have hxz : x = z := hxy.trans hzy.symm
      subst z
      exact E.val.refl x⟩
  exact ⟨⟨E,D⟩,le_refl E⟩

/-- The REAL target transported kernel of the initial identity
normal datum is exactly E, including real diagonal, not merely
an abstract setoid isomorphic to it. -/
theorem originalCanonicalUnaryNormalDatum_ident_target
    (H : HomogeneousSource S G) {i : ι} (E : ColourEq S i) :
    let N := originalCanonicalUnaryNormalDatum_ident S H E
    originalTransportTargetColourEq S H N.val.2.val.1
      (originalCanonicalRawTransitionDatum_transport S H N.val.2) = E := by
  let N := originalCanonicalUnaryNormalDatum_ident S H E
  let T := originalCanonicalRawTransitionDatum_transport S H N.val.2
  have hId : ∀ x : X i, N.val.2.val.2.val.val x x := by
    intro x
    change x = x
    rfl
  have hTarget : T.target =
      originalColourEqAsInvEq S H E :=
    original_identity_included_transport_target_eq_source T hId
  apply ColourEq.ext
  intro x y
  change T.target x y ↔ E x y
  rw [hTarget]
  exact Iff.rfl

/-- On a real representative, the identity normal datum evaluates
to the genuine same E-class, as required for the base case of the
arbitrary mixed-term induction. -/
theorem originalCanonicalUnaryNormalDatum_ident_edge
    (H : HomogeneousSource S G) {i : ι} (E : ColourEq S i)
    (x : X i) :
    let N := originalCanonicalUnaryNormalDatum_ident S H E
    (originalCanonicalUnaryNormalDatum_function S H N).2.2
      (Quotient.mk E.val x) =
      Quotient.mk
        (originalTransportTargetColourEq S H N.val.2.val.1
          (originalCanonicalRawTransitionDatum_transport S H N.val.2)).val x := by
  let N := originalCanonicalUnaryNormalDatum_ident S H E
  have hR : N.val.2.val.2.val.val x x := by
    change x = x
    rfl
  exact originalCanonicalUnaryNormalDatum_real_edge S H N x x hR

end CCO.TransitionClosure
