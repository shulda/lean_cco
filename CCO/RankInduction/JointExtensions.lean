import CCO.RankInduction.JointInputs
import CCO.RankInduction.JointMasterActions

/-! Every original sparse source request is extended on the SAME fixed
joint carrier, retaining one full master action in every factor. -/

universe v w t
namespace CCO.RankInduction.Factors
noncomputable section
open RawExact ExactCRT CanonicalQuotients Owners.Product Owners.Provider Owners.Master
open Owners.Joint MIGeometry ParityHasse.Original FinitePackets.Normalization RealClosure.Bounds

variable {M : Type v} (S : AtomicSource.{0,v,w} Unit (fun _ => M))
variable {G : Type t} [Group G] [MulAction G M] [Countable M] [DecidableEq M]
variable (H : HomogeneousSource S G) (cco : SemanticCCO.{0,v,v,w} S)
variable (normalized : NoFiniteExactKernel S)
variable {A0 : Set M} {safe : Set (S.Atom () ())}
variable (F : SourceStage S H cco normalized A0 safe)

local instance jointExtensionsCoreInvariant (D : Direction S) : Invariant G (factorCore S H cco D).val :=
  exactInvariant S H cco (factorCore S H cco D)
local instance jointExtensionsOwnerInvariant (D : Direction S) :
    Invariant G (factorOwner S H cco normalized D).val :=
  exactInvariant S H cco (factorOwner S H cco normalized D)
local instance jointExtensionsJointInvariant : Invariant G (jointKernel S H cco normalized).val :=
  exactInvariant S H cco (jointKernel S H cco normalized)

/-- The entire structural group is the full matching group, not merely
the subgroup generated by individually selected request extensions. -/
def stage_full_automorphisms :=
  (jointGeometry S H cco normalized).actualInducedAutEquiv F.master.carrier
    (stageCarriers S H cco normalized F) (stageOver S H cco normalized F)
    (stageOnto S H cco normalized F) (stageFullOwners S H cco normalized F)

theorem stage_owner_image :
    (jointGeometry S H cco normalized).joint '' stageCarrier S H cco normalized F = F.master.carrier := by
  let P := jointGeometry S H cco normalized
  let Q := P.inducedOwnerQuotient F.master.carrier (stageCarriers S H cco normalized F)
    (stageOver S H cco normalized F) (stageOnto S H cco normalized F)
    (stageFullOwners S H cco normalized F)
  ext b
  constructor
  · rintro ⟨x, hx, rfl⟩
    have he : (Q.projection (⟨x, hx⟩ : stageCarrier S H cco normalized F)).val = P.joint x :=
      Q.commutes ⟨x, hx⟩
    exact he ▸ (Q.projection ⟨x, hx⟩).property
  · intro hb
    obtain ⟨x, hx⟩ := Q.surjective ⟨b, hb⟩
    exact ⟨x.val, x.property, (Q.commutes x).symm.trans (congrArg Subtype.val hx)⟩

/-- The actual natural joint-owner restriction has M3 from the SAME
lower master, including its fibre-transitive kernel on the literal B. -/
theorem stage_joint_m3 (D : Direction S) :
    Function.Surjective ((jointGeometry S H cco normalized).jointAction F.master.carrier D) ∧
      GroupActions.FibreTransitive
        ((jointGeometry S H cco normalized).jointAction F.master.carrier D)
        (((jointGeometry S H cco normalized).finiteDiagram F.master.carrier).beta D) :=
  master_carrier_m3 S H cco (jointKernel S H cco normalized)
    (factorOwner S H cco normalized D) (jointKernel_le_owner S H cco normalized D) F.master

theorem stage_owner_eppa (finiteA : A0.Finite) :
    EPPAFor (G := G) (ι := (Subtype.val : F.master.carrier → _))
      (((jointGeometry S H cco normalized).ownerQuotient F.master.carrier
        (stageCarriers S H cco normalized F) (stageOver S H cco normalized F)
        (stageOnto S H cco normalized F) (stageFullOwners S H cco normalized F)).projection ''
          stageTupleInput S H cco normalized F) := by
  have ep := master_carrier_eppa S H cco (jointKernel S H cco normalized) F.master
  exact Eq.mpr (congrArg (fun A : Set F.master.carrier =>
    EPPAFor (G := G) (ι := (Subtype.val : F.master.carrier → _)) A)
    (stage_owner_shadow S H cco normalized F finiteA)) ep

/-- The owner's M1 extends the ENTIRE owner shadow first; every factor
then receives that same action on ALL of its coarse owners. Sparse and
empty original real domains remain genuine partial requests. -/
theorem stage_tuple_eppa (finiteA : A0.Finite) :
    EPPAFor (G := G)
      (ι := (jointGeometry S H cco normalized).point F.master.carrier
        (stageCarriers S H cco normalized F) (stageOver S H cco normalized F))
      (stageTupleInput S H cco normalized F) := by
  apply (jointGeometry S H cco normalized).eppa_sparse F.master.carrier
    (stageCarriers S H cco normalized F) (stageOver S H cco normalized F)
    (stageOnto S H cco normalized F) (stageFullOwners S H cco normalized F)
    (stageTupleInput S H cco normalized F)
  · exact stage_owner_eppa S H cco normalized F finiteA
  · intro D
    rw [stage_coordinate_shadow S H cco normalized F finiteA D]
    exact (F.component D).prescribed

theorem stage_extensions (finiteA : A0.Finite) :
    EPPAFor (G := G) (ι := (Subtype.val : stageCarrier S H cco normalized F → M))
      {x | x.val ∈ A0} := by
  apply eppa_congr (stageTupleEquiv S H cco normalized F) (fun _ => rfl) {x | x.val ∈ A0}
  exact stage_tuple_eppa S H cco normalized F finiteA

end
end CCO.RankInduction.Factors
