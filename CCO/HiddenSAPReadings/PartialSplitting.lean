import CCO.HiddenSAPReadings.Assignments
import CCO.HiddenSAPReadings.SourceSupport

/-! Source13 representative splitting on the ACTUAL partial hidden source.
The new map preserves every displayed binary predicate and typed unary
graph, fixes every proper hidden image, and has distinct real images and
distinct designated proper representatives in one finite visible extension.
The conclusion even applies to a homomorphism before requiring HE. -/
universe u v w r z
namespace CCO.HiddenSAPReadings
open CCO.ParityHasse.Original CCO.TransitionClosure CCO.UnaryTermsReturn
open CCO.TypedOrbitFrames CCO.UnaryFreshFrames
noncomputable section
variable {ι : Type u} {X : ι → Type v} (S : AtomicSource.{u,v,w} ι X)
variable {G : Type r} [Group G] [∀ i : ι, MulAction G (X i)]
variable (H : HomogeneousSource S G) (sap : AgeSAP S) (nr2 : Selectors.OriginalNR2 S)

theorem labelled_step_target_proper {s : OriginalCompletedPrimitiveSymbol S H}
    {x y : OriginalCompletedNamedCarrier S H}
    (h : OriginalCompletedNamedLabelledStep S H sap nr2 s x y) :
    ¬ ∃ a : Sigma X, y = .inl a := by
  cases h <;> rintro ⟨a,ha⟩ <;> cases ha

namespace SplitAssignment
variable {S H sap nr2} {P : Type z} {f : P → OriginalCompletedNamedCarrier S H}
variable {A : Set (Sigma X)} (r : SplitAssignment S H f A)

theorem preserves_binary (R : OriginalCompletedCylinderBinaryName S H) {p q : P}
    (h : originalCompletedCylinderBinaryPredicate S H R (f p) (f q)) :
    originalCompletedCylinderBinaryPredicate S H R (r.point p) (r.point q) := by
  obtain ⟨g,hgp,hgq⟩ := r.pair_motion p q h.1
  have hh := original_completed_binary_preserved S H g R (f p) (f q) h
  rwa [hgp,hgq] at hh

theorem preserves_labelled_step {s : OriginalCompletedPrimitiveSymbol S H} {p q : P}
    (h : OriginalCompletedNamedLabelledStep S H sap nr2 s (f p) (f q)) :
    OriginalCompletedNamedLabelledStep S H sap nr2 s (r.point p) (r.point q) := by
  classical
  by_cases he : f p = f q
  · have hq : ¬ IsRealPosition S H f q := labelled_step_target_proper S H sap nr2 h
    have hp : ¬ IsRealPosition S H f p := by
      simpa only [IsRealPosition,he] using hq
    rw [r.proper_fixed p hp,r.proper_fixed q hq]
    exact h
  · obtain ⟨g,hgp,hgq⟩ := r.pair_motion p q he
    have hh := original_completed_labelled_step_equivariant S H sap nr2 g h
    rwa [hgp,hgq] at hh

end SplitAssignment

variable {P : Type z}
variable (C : CCO.UnarySupport.Structure (originalPartialSignature S H sap nr2) P)
variable (f : CCO.UnarySupport.Structure.Hom C (originalPartialTarget S H sap nr2))

def splitAssignmentHom {A : Set (Sigma X)} (r : SplitAssignment S H f.point A) :
    CCO.UnarySupport.Structure.Hom C (originalPartialTarget S H sap nr2) where
  point := r.point
  sort_eq p := (congrArg ULift.up (r.sort_eq p)).trans (f.sort_eq p)
  map_func F p q h := by
    classical
    have hh := f.map_func F p q h
    have hs := ((originalPartialTarget S H sap nr2).func_sorted F (f.point p) (f.point q) hh).1
    change (originalCompletedStructure S H sap nr2).sort (f.point p) =
      (originalCompletedLanguage S H sap nr2).input F at hs
    have hy : f.point q = (originalCompletedStructure S H sap nr2).func F (f.point p) := by
      simpa only [originalPartialTarget,partialTarget,if_pos hs,Set.mem_singleton_iff] using hh
    have hStep := original_completed_primitive_function_graph S H sap nr2 F.down (f.point p)
      (congrArg ULift.down hs)
    change OriginalCompletedNamedLabelledStep S H sap nr2 F.down (f.point p)
      ((originalCompletedStructure S H sap nr2).func F (f.point p)) at hStep
    rw [← hy] at hStep
    have hNew := r.preserves_labelled_step hStep
    have hs' : (originalCompletedStructure S H sap nr2).sort (r.point p) =
        (originalCompletedLanguage S H sap nr2).input F :=
      congrArg ULift.up (original_completed_labelled_input_sort S H sap nr2 hNew)
    have he := original_completed_primitive_function_of_graph S H sap nr2 hNew
    change r.point q ∈ if (originalCompletedStructure S H sap nr2).sort (r.point p) =
      (originalCompletedLanguage S H sap nr2).input F then
        {(originalCompletedStructure S H sap nr2).func F (r.point p)} else ∅
    rw [if_pos hs']
    exact he.symm
  map_rel R xs h := by
    change (Fin 2 → P) at xs
    exact r.preserves_binary R (f.map_rel R xs h)

/-- Every retained proper image is generated by its designated actual
anchor; no old real root is invented inside an orphan source subobject. -/
theorem splitAssignment_image_in_visible_closure {A : Set (Sigma X)}
    (r : SplitAssignment S H f.point A) (p : P) :
    r.point p ∈ (originalCompletedStructure S H sap nr2).closure (Sum.inl '' r.world.vertices) := by
  classical
  by_cases hp : IsRealPosition S H f.point p
  · obtain ⟨a,ha⟩ := hp
    have hs : (originalCompletedStructure S H sap nr2).sort (r.point p) = ⟨⟨a.1,.inl ()⟩⟩ := by
      change ULift.up (originalCompletedVertexSort S H (r.point p)) = _
      rw [r.sort_eq p,ha]
      cases a
      rfl
    obtain ⟨x,hx⟩ := original_completed_real_carrier_exists S H sap nr2 ⟨r.point p,hs⟩
    have hx' : r.point p = .inl (⟨a.1,x⟩ : Sigma X) := hx
    exact (originalCompletedStructure S H sap nr2).subset_closure _
      ⟨⟨a.1,x⟩,r.real_in_world p _ hx',hx'.symm⟩
  · let q : ProperPosition S H f.point := ⟨p,hp⟩
    let req := properPositionRequest S H f.point q
    obtain ⟨a,ha,hrep⟩ := r.representative_class q
    have haWorld : (⟨req.1,a⟩ : Sigma X) ∈ r.world.vertices :=
      ha ▸ r.representatives_in_world q
    have hSeed : (.inl (⟨req.1,a⟩ : Sigma X) : OriginalCompletedNamedCarrier S H) ∈
        (originalCompletedStructure S H sap nr2).closure (Sum.inl '' r.world.vertices) :=
      (originalCompletedStructure S H sap nr2).subset_closure _ ⟨_,haWorld,rfl⟩
    have hClosed := (originalCompletedStructure S H sap nr2).closure_closed
      (Sum.inl '' r.world.vertices) (ULift.up (Sum.inl ⟨req.1,req.2.1⟩)) _ hSeed
    change originalCompletedPrimitiveFunction S H sap nr2 (Sum.inl ⟨req.1,req.2.1⟩)
      (.inl ⟨req.1,a⟩) ∈ _ at hClosed
    rw [original_completed_primitive_function_of_graph S H sap nr2
      (OriginalCompletedNamedLabelledStep.projection req.2.1 a),hrep,
      properPositionRequest_eq S H f.point q] at hClosed
    rwa [r.proper_fixed p hp]

/-- Actual source result with a finite completed induced target inside
ONE visible extension. All binary source data and genuine typed function
domains are preserved; no CCO or hidden SAP/homogeneity premise is used. -/
theorem typed_partial_real_sort_splitting [Finite P]
    (A : Set (Sigma X)) (hA : A.Finite) :
    ∃ r : SplitAssignment S H f.point A,
      ∃ (D : (originalCompletedStructure S H sap nr2).Piece)
        (hD : (originalPartialTarget S H sap nr2).IsClosed D.points),
        ∃ g : CCO.UnarySupport.Structure.Hom C
          ((originalPartialTarget S H sap nr2).induce D.points hD),
          (∀ p, (g.point p).val = r.point p) ∧
          D.points = (originalCompletedStructure S H sap nr2).closure (Sum.inl '' r.world.vertices) := by
  obtain ⟨r⟩ := split_finite_assignment S H f.point sap A hA
  let V : Set (OriginalCompletedNamedCarrier S H) := Sum.inl '' r.world.vertices
  let D : (originalCompletedStructure S H sap nr2).Piece :=
    ⟨(originalCompletedStructure S H sap nr2).closure V,
      (originalCompletedStructure S H sap nr2).locallyFinite_of_singletons
        (original_completed_all_singleton_closures_finite S H sap nr2) V
        (r.world.finite_vertices.image _),
      (originalCompletedStructure S H sap nr2).closure_closed V⟩
  have hD : (originalPartialTarget S H sap nr2).IsClosed D.points :=
    (partialTarget_closed_iff _ _).mpr D.closed
  let f' := splitAssignmentHom S H sap nr2 C f r
  let g : CCO.UnarySupport.Structure.Hom C
      ((originalPartialTarget S H sap nr2).induce D.points hD) := {
    point p := ⟨r.point p,splitAssignment_image_in_visible_closure S H sap nr2 C f r p⟩
    sort_eq := f'.sort_eq
    map_func F p q h := f'.map_func F p q h
    map_rel R xs h := f'.map_rel R xs h }
  exact ⟨r,D,hD,g,fun _ => rfl,rfl⟩

end
end CCO.HiddenSAPReadings
