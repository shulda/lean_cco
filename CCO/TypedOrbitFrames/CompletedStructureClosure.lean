import CCO.TypedOrbitFrames.CompletedSignature
import CCO.TypedOrbitFrames.RealBaseClosureBound

/-! The generic actual unary STRUCTURE closure is exactly the already
proved full B052 named-primitive closure, including every orphan input.
Thus generic term syntax introduces no extra operations or generators. -/

namespace CCO.TypedOrbitFrames

open CCO.ParityHasse.Original CCO.TransitionClosure CCO.UnaryTermsReturn
open CCO.UnaryFreshFrames

universe u v w r
variable {ι : Type u} {X : ι → Type v}
variable (S : AtomicSource.{u,v,w} ι X)
variable {G : Type r} [Group G] [∀ j : ι, MulAction G (X j)]

theorem original_completed_structure_closureAt_eq
    (H : HomogeneousSource S G) (sap : AgeSAP S)
    (nr2 : Selectors.OriginalNR2 S) (x : OriginalCompletedNamedCarrier S H) :
    (originalCompletedStructure S H sap nr2).closureAt x =
      originalCompletedNamedStepClosure S H sap nr2 x := by
  classical
  let C := originalCompletedStructure S H sap nr2
  apply Set.Subset.antisymm
  · apply C.closure_minimal
    · intro s y hy
      by_cases hSort : originalCompletedVertexSort S H y =
          originalCompletedPrimitiveInput S H s.down
      · exact OriginalCompletedNamedReachable.step hy
          (original_completed_labelled_step_forget S H sap nr2
            (original_completed_primitive_function_graph S H sap nr2 s.down y hSort))
      · have hOff : C.sort y ≠ (originalCompletedLanguage S H sap nr2).input s :=
          fun h => hSort (congrArg ULift.down h)
        rw [C.func_offsort s y hOff]
        exact hy
    · intro y hy
      have hyx : y = x := hy
      subst y
      exact OriginalCompletedNamedReachable.refl _
  · apply original_completed_named_step_closure_minimal S H sap nr2 x
    · exact C.subset_closure {x} rfl
    · intro a b ha hStep
      obtain ⟨s,hs⟩ := original_completed_step_has_actual_label S H sap nr2 hStep
      have hClosed := C.closure_closed {x} (ULift.up s) a ha
      change originalCompletedPrimitiveFunction S H sap nr2 s a ∈ C.closureAt x at hClosed
      rwa [original_completed_primitive_function_of_graph S H sap nr2 hs] at hClosed

theorem original_completed_structure_real_base_closure_eq
    (H : HomogeneousSource S G) (sap : AgeSAP S)
    (nr2 : Selectors.OriginalNR2 S) (D : Set (Sigma X)) :
    (originalCompletedStructure S H sap nr2).closure (Sum.inl '' D) =
      originalCompletedRealBaseClosure S H sap nr2 D := by
  ext y
  rw [Structure.mem_closure_iff_singleton]
  constructor
  · rintro ⟨_,⟨x,hx,rfl⟩,hy⟩
    rw [original_completed_structure_closureAt_eq] at hy
    exact Set.mem_iUnion.mpr ⟨x,Set.mem_iUnion.mpr ⟨hx,hy⟩⟩
  · intro hy
    obtain ⟨x,hx⟩ := Set.mem_iUnion.mp hy
    obtain ⟨hxD,hxy⟩ := Set.mem_iUnion.mp hx
    refine ⟨.inl x,⟨x,hxD,rfl⟩,?_⟩
    rwa [original_completed_structure_closureAt_eq]

/-- The actual structure is point-generated by original reals. A real
representative used to prove this ambient existence is never inserted
into an orphan finite closed member. -/
theorem original_completed_structure_point_generated
    (H : HomogeneousSource S G) (sap : AgeSAP S)
    (nr2 : Selectors.OriginalNR2 S) (x : OriginalCompletedNamedCarrier S H) :
    ∃ p : Sigma X, x ∈ (originalCompletedStructure S H sap nr2).closureAt (.inl p) := by
  cases x with
  | inl x =>
      refine ⟨x,?_⟩
      rw [original_completed_structure_closureAt_eq]
      exact OriginalCompletedNamedReachable.refl _
  | inr x =>
      obtain ⟨i,J,q,hx⟩ := original_completed_hidden_value_has_named_witness S H x
      rw [hx]
      induction q using Quotient.inductionOn with
      | _ q =>
          refine ⟨⟨i,q⟩,?_⟩
          rw [original_completed_structure_closureAt_eq]
          exact OriginalCompletedNamedReachable.step (.refl _) (.projection J q)

theorem original_completed_structure_real_base_locally_finite
    (H : HomogeneousSource S G) (sap : AgeSAP S)
    (nr2 : Selectors.OriginalNR2 S) (D : Set (Sigma X)) (hD : D.Finite) :
    ((originalCompletedStructure S H sap nr2).closure (Sum.inl '' D)).Finite := by
  rw [original_completed_structure_real_base_closure_eq]
  exact original_completed_real_base_closure_finite S H sap nr2 D hD

end CCO.TypedOrbitFrames
