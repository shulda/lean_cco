import CCO.CloneSAP.Lattice.Palettes
import Mathlib.Data.Fintype.Perm
import Mathlib.GroupTheory.Perm.Fin

/-! C34. All directed difference colours on the regular S₃ structure.
The infinite symmetric-source theorem is not used in this boundary. -/

namespace CCO.CloneSAP.Lattice.DirectedBoundary

abbrev Point := Equiv.Perm (Fin 3)
def s : Point := Equiv.swap 0 1
def t : Point := Equiv.swap 1 2

/-- The identity difference is exactly logical equality; the other five
differences are actual irreflexive named diversity colours. -/
def difference (x y : Point) : Point := x⁻¹ * y

theorem difference_one (x y : Point) : difference x y = 1 ↔ x = y := by
  simp only [difference, inv_mul_eq_one]

theorem difference_occurs (a : Point) : ∃ x y, difference x y = a := by
  exact ⟨1, a, by simp [difference]⟩

theorem left_translation_preserves (g x y : Point) :
    difference (g * x) (g * y) = difference x y := by
  simp [difference, mul_assoc]

/-- Any finite complete partial isomorphism agrees with one left
translation, including the empty tuple. Thus the directed structure
really is homogeneous, not just transitive. -/
theorem homogeneous {V : Type*} (f h : V → Point)
    (hp : ∀ a b, difference (f a) (f b) = difference (h a) (h b)) :
    ∃ g : Point, ∀ a, g * f a = h a := by
  classical
  by_cases hn : Nonempty V
  · let a := Classical.choice hn
    refine ⟨h a * (f a)⁻¹, ?_⟩
    intro b
    have he := congrArg (fun z : Point => h a * z) (hp a b)
    simpa only [difference, ← mul_assoc, mul_inv_cancel, one_mul] using he
  · refine ⟨1, ?_⟩
    intro a
    exact False.elim (hn ⟨a⟩)

/-- Right cosets of the subgroup generated by (01). -/
def E : Setoid Point where
  r x y := difference x y = 1 ∨ difference x y = s
  iseqv := by constructor <;> decide

/-- Right cosets of the subgroup generated by (12). -/
def F : Setoid Point where
  r x y := difference x y = 1 ∨ difference x y = t
  iseqv := by constructor <;> decide

theorem E_invariant (g x y : Point) (h : E x y) : E (g * x) (g * y) := by
  change difference (g * x) (g * y) = 1 ∨ difference (g * x) (g * y) = s
  rw [left_translation_preserves]
  exact h

theorem F_invariant (g x y : Point) (h : F x y) : F (g * x) (g * y) := by
  change difference (g * x) (g * y) = 1 ∨ difference (g * x) (g * y) = t
  rw [left_translation_preserves]
  exact h

theorem ordered_product_witness :
    RawSymmetric.compose E F 1 (s * t) ∧
      ¬ RawSymmetric.compose F E 1 (s * t) := by
  unfold RawSymmetric.compose E F
  change (∃ z : Point,
    (difference 1 z = 1 ∨ difference 1 z = s) ∧
    (difference z (s * t) = 1 ∨ difference z (s * t) = t)) ∧
      ¬ ∃ z : Point, (difference 1 z = 1 ∨ difference 1 z = t) ∧
        (difference z (s * t) = 1 ∨ difference z (s * t) = s)
  decide

/-- Actual invariant equivalences of a homogeneous directed atomic
structure fail to commute. Symmetry is a material hypothesis. -/
theorem products_do_not_commute :
    RawSymmetric.compose E F ≠ RawSymmetric.compose F E := by
  intro he
  exact ordered_product_witness.2 (he ▸ ordered_product_witness.1)

end CCO.CloneSAP.Lattice.DirectedBoundary
