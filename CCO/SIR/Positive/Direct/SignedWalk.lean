import Mathlib.Combinatorics.SimpleGraph.Paths
import Mathlib.Combinatorics.SimpleGraph.Connectivity.Connected

/-! Elementary signed-walk cancellation. Simple cycles suffice: a repeated
vertex splits off a shorter closed walk; an immediate return cancels twice. -/

namespace CCO.SIR.Positive.Direct.SignedWalk

variable {V : Type*} {K : SimpleGraph V}

def parity (weight : V → V → Bool) : {u v : V} → K.Walk u v → Bool
  | _, _, .nil => false
  | u, _, .cons (v := v) _ p => weight u v ^^ parity weight p

@[simp] theorem parity_nil (weight : V → V → Bool) (u : V) :
    parity weight (.nil : K.Walk u u) = false := rfl

@[simp] theorem parity_cons (weight : V → V → Bool) {u v w : V}
    (h : K.Adj u v) (p : K.Walk v w) :
    parity weight (.cons h p) = (weight u v ^^ parity weight p) := rfl

@[simp] theorem parity_append (weight : V → V → Bool) {u v w : V}
    (p : K.Walk u v) (q : K.Walk v w) :
    parity weight (p.append q) = (parity weight p ^^ parity weight q) := by
  induction p with
  | nil => simp [parity]
  | cons h p ih => simp [parity, ih, Bool.xor_assoc]

theorem parity_reverse (weight : V → V → Bool)
    (hsym : ∀ x y, weight x y = weight y x) {u v : V} (p : K.Walk u v) :
    parity weight p.reverse = parity weight p := by
  induction p with
  | nil => rfl
  | @cons u v w h p ih =>
      simp [SimpleGraph.Walk.reverse_cons, parity_append, parity, ih,
        hsym v u, Bool.xor_comm]

/-- Telescoping the actual signs along an indexed walk. -/
theorem parity_of_getVert (weight : V → V → Bool) {u v : V}
    (p : K.Walk u v) (f : ℕ → Bool)
    (hstep : ∀ n < p.length,
      weight (p.getVert n) (p.getVert (n + 1)) = (f n ^^ f (n + 1))) :
    parity weight p = (f 0 ^^ f p.length) := by
  induction p generalizing f with
  | nil => simp [parity]
  | @cons u v w h p ih =>
      have hzero := hstep 0 (by simp)
      have htail : ∀ n < p.length,
          weight (p.getVert n) (p.getVert (n + 1)) = (f (n + 1) ^^ f (n + 1 + 1)) := by
        intro n hn
        simpa using hstep (n + 1) (by simp; omega)
      have hh := ih (fun n => f (n + 1)) htail
      simp only [SimpleGraph.Walk.getVert_zero,
        SimpleGraph.Walk.getVert_cons_succ] at hzero
      rw [parity_cons, hzero, hh]
      simp only [SimpleGraph.Walk.length_cons, Bool.xor_assoc]
      cases f (0 + 1) <;> simp

/-- Every closed walk is generated by genuine simple cycles and immediate
two-edge returns. In particular any symmetric Boolean signing vanishing on
simple cycles vanishes on every closed walk. -/
theorem closed_parity_zero (weight : V → V → Bool)
    (hsym : ∀ x y, weight x y = weight y x)
    (hcycle : ∀ u (p : K.Walk u u), p.IsCycle → parity weight p = false)
    (u : V) (p : K.Walk u u) : parity weight p = false := by
  classical
  generalize hn : p.length = n
  induction n using Nat.strong_induction_on generalizing u with
  | h n ih =>
    cases p with
    | nil => rfl
    | @cons u v _ h q =>
      by_cases hlen : 3 ≤ (SimpleGraph.Walk.cons h q).length
      · by_cases hp : q.IsPath
        · exact hcycle _ _
            ((SimpleGraph.Walk.isCycle_iff_isPath_tail_and_le_length).mpr
              ⟨by simpa using hp, hlen⟩)
        · have hex : ∃ (w : V) (r : K.Walk w w), r.IsSubwalk q ∧ ¬ r.Nil := by
            have hh := mt SimpleGraph.Walk.isPath_iff_isSubwalk_imp_nil.mpr hp
            simpa only [not_forall, not_imp, exists_prop] using hh
          obtain ⟨w, r, ⟨a, b, hab⟩, hr⟩ := hex
          have hrpos : 0 < r.length := Nat.pos_of_ne_zero
            (fun hz => hr (SimpleGraph.Walk.length_eq_zero_iff.mp hz))
          have hlenq : q.length + 1 = n := by simpa using hn
          have hparts : q.length = a.length + r.length + b.length := by
            simp [hab]
          have hrlt : r.length < n := by omega
          have hz := ih r.length hrlt w r rfl
          let short : K.Walk u u := .cons h (a.append b)
          have hshort : short.length < n := by
            simp only [short, SimpleGraph.Walk.length_cons,
              SimpleGraph.Walk.length_append]
            omega
          have hzero := ih short.length hshort u short rfl
          simpa only [short, hab, parity_cons, parity_append, hz,
            Bool.xor_false] using hzero
      · cases q with
        | nil => exact (h.ne rfl).elim
        | @cons v w u h' q =>
          cases q with
          | nil => simp [parity, hsym u v]
          | cons h'' r =>
            simp only [SimpleGraph.Walk.length_cons] at hlen
            omega

/-- Choose a reference walk separately in each actual connected component.
Vanishing closed-walk signs makes the resulting sheet potential consistent.
This statement permits infinite vertex types. -/
theorem exists_potential (weight : V → V → Bool)
    (hclosed : ∀ u (p : K.Walk u u), parity weight p = false) :
    ∃ f : V → Bool, ∀ x y, K.Adj x y → weight x y = (f x ^^ f y) := by
  classical
  let path (C : K.ConnectedComponent) (v : C) : K.Walk C.out v.val :=
    (C.reachable_of_mem_supp C.out_eq v.property).some
  let potential (C : K.ConnectedComponent) (v : C) := parity weight (path C v)
  have hpot (C : K.ConnectedComponent) (x y : C) (hxy : K.Adj x.val y.val) :
      weight x.val y.val = (potential C x ^^ potential C y) := by
    let closed : K.Walk C.out C.out :=
      ((path C x).append hxy.toWalk).append (path C y).reverse
    have hh := hclosed C.out closed
    have hrev (p : K.Walk C.out y.val) : parity weight p.reverse = parity weight p := by
      have hzero := hclosed C.out (p.append p.reverse)
      rw [parity_append] at hzero
      cases ha : parity weight p <;> cases hb : parity weight p.reverse <;> simp_all
    simp only [closed,parity_append,hrev,SimpleGraph.Adj.toWalk,
      parity_cons,parity_nil,Bool.xor_false] at hh
    change (potential C x ^^ weight x.val y.val ^^ potential C y) = false at hh
    cases hx : potential C x <;> cases hy : potential C y <;>
      cases hw : weight x.val y.val <;> simp_all
  let f : V → Bool := fun v =>
    potential (K.connectedComponentMk v) ⟨v,SimpleGraph.ConnectedComponent.connectedComponentMk_mem⟩
  refine ⟨f, ?_⟩
  intro x y hxy
  have hy : K.connectedComponentMk y = K.connectedComponentMk x :=
    (SimpleGraph.ConnectedComponent.connectedComponentMk_eq_of_adj hxy).symm
  have hh := hpot (K.connectedComponentMk x) ⟨x,rfl⟩ ⟨y,hy⟩ hxy
  have hcast {C C' : K.ConnectedComponent} (heq : C = C')
      (v : V) (hv : v ∈ C) (hv' : v ∈ C') :
      potential C ⟨v,hv⟩ = potential C' ⟨v,hv'⟩ := by
    cases heq
    rfl
  have hfy : f y = potential (K.connectedComponentMk x) ⟨y,hy⟩ :=
    hcast hy y _ _
  change weight x y = (f x ^^ f y)
  rw [hfy]
  exact hh

end CCO.SIR.Positive.Direct.SignedWalk
