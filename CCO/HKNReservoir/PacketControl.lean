import CCO.HKNReservoir.HKNLanguage
import AllThoseEPPA.TreeLikeFaithfulEmbeddingBridge
import AllThoseEPPA.TreeLikeTreeIrreducibleExtension
import AllThoseEPPA.TreeLikeHomEmbClosedIrreducibleImage

/-! Packet control in arbitrary external output structures. In particular
no functionality, owner exclusivity or matrix axioms are assumed there. -/
universe u v w z x y
namespace CCO.HKNReservoir
open AllThoseEPPA
variable {B : Type u} {K : Type v} {Atom : Type w}
variable {V : Type x} {W : Type y} {Γ : Type z} [Group Γ]
variable (tag : Γ →* Equiv.Perm B)

/-- An internal discharge interface, proved below from each actual HKN
faithful witness and each actual tree construction. -/
abbrev LocallyInSource (A : Structure (Signature B K Atom) V)
    (D : Structure (Signature B K Atom) W) : Prop :=
  TreeLike.EveryIrreducibleEmbedsIn (action tag) A D

theorem locallyInSource_of_faithful
    {A : Structure (Signature B K Atom) V} {D : Structure (Signature B K Atom) W}
    (ψ : Structure.Embedding (action tag) A D)
    (h : Structure.IsIrreducibleStructureFaithful (action tag) ψ) :
    LocallyInSource tag A D :=
  TreeLike.everyIrreducibleEmbedsIn_of_faithful (action tag) A D ψ h

/-- The external recursive tree theorem supplies an actual inverse into
one FULL source copy, with its single global language component. -/
theorem locallyInSource_of_tree {A : Structure (Signature B K Atom) V}
    {D : Structure (Signature B K Atom) V}
    (h : TreeLike.TreeAmalgamation (action tag) A D) : LocallyInSource tag A D := by
  intro P hP hi
  obtain ⟨e,he⟩ := h.everyIrreducibleExtendsToA (action tag) A P hP hi
  exact ⟨Faithful.embeddingInverseOnClosedSubset (action tag) e P hP he⟩

/-- Union closure uses only that every named function is unary. -/
theorem closed_union (D : Structure (Signature B K Atom) V)
    {P Q : Set V} (hP : D.IsClosed P) (hQ : D.IsClosed Q) : D.IsClosed (P ∪ Q) := by
  intro n F xs hxs a ha
  cases F with
  | translate k =>
    have htuple : ∀ i : Fin 1, xs i = xs 0 := fun i => congrArg xs (Subsingleton.elim _ _)
    rcases hxs 0 with hx | hx
    · exact Or.inl (hP (.translate k) xs (fun i => htuple i ▸ hx) ha)
    · exact Or.inr (hQ (.translate k) xs (fun i => htuple i ▸ hx) ha)

private theorem irreducible_set_congr (D : Structure (Signature B K Atom) V)
    {P Q : Set V} (hP : D.IsClosed P) (hQ : D.IsClosed Q) (he : P = Q)
    (hi : (D.induce P hP).IsIrreducible) : (D.induce Q hQ).IsIrreducible := by
  subst Q
  exact hi

/-- A regular packet generated by any one of its points is irreducible.
This concerns its whole CLOSED carrier, never an unclosed singleton. -/
theorem packet_irreducible (D : Structure (Signature B K Atom) V)
    (P : Set V) (hP : D.IsClosed P) (p : V) (he : D.closureAtSet p = P) :
    (D.induce P hP).IsIrreducible := by
  subst P
  exact D.closureAt_isIrreducible p

/-- One cross fine edge suffices; no matrix/nonthin assumption occurs. -/
theorem two_packet_irreducible (D : Structure (Signature B K Atom) V)
    {P Q : Set V} (hP : D.IsClosed P) (hQ : D.IsClosed Q)
    {p q : V} (hp : D.closureAtSet p = P) (hq : D.closureAtSet q = Q)
    (a : Atom) (hrel : D.rel (.fine a) (![p,q])) :
    (D.induce (P ∪ Q) (closed_union D hP hQ)).IsIrreducible := by
  have he : D.closureSet (Set.range (![p,q] : Fin 2 → V)) = P ∪ Q := by
    apply Set.Subset.antisymm
    · apply D.closureSet_minimal (closed_union D hP hQ)
      rintro x ⟨i,rfl⟩
      fin_cases i
      · exact Or.inl (hp ▸ D.mem_closureAtSet p)
      · exact Or.inr (hq ▸ D.mem_closureAtSet q)
    · rintro x (hx | hx)
      · rw [← hp] at hx
        exact D.closureSet_mono (by
          intro y hy; have hy' : y = p := hy; subst y
          exact ⟨0,rfl⟩) hx
      · rw [← hq] at hx
        exact D.closureSet_mono (by
          intro y hy; have hy' : y = q := hy; subst y
          exact ⟨1,rfl⟩) hx
  have hi := D.relationTupleClosure_isIrreducible (.fine a) (![p,q]) hrel
  change (D.induce (D.closureSet (Set.range (![p,q] : Fin 2 → V))) _).IsIrreducible at hi
  exact irreducible_set_congr D _ _ he hi

/-- Exact local restrictions retain the SAME language component, all
relation reflections and WHOLE unary value sets. -/
theorem homEmbedding_packet_exact
    {D : Structure (Signature B K Atom) V} {E : Structure (Signature B K Atom) W}
    (f : Structure.Homomorphism (action tag) D E)
    (hf : Structure.Homomorphism.IsHomomorphismEmbedding (action tag) f)
    (P : Set V) (hP : D.IsClosed P) (p : V) (he : D.closureAtSet p = P) :
    Structure.Homomorphism.IsEmbeddingOn (action tag) f P :=
  hf P hP (packet_irreducible D P hP p he)

theorem homEmbedding_two_packet_exact
    {D : Structure (Signature B K Atom) V} {E : Structure (Signature B K Atom) W}
    (f : Structure.Homomorphism (action tag) D E)
    (hf : Structure.Homomorphism.IsHomomorphismEmbedding (action tag) f)
    {P Q : Set V} (hP : D.IsClosed P) (hQ : D.IsClosed Q)
    {p q : V} (hp : D.closureAtSet p = P) (hq : D.closureAtSet q = Q)
    (a : Atom) (hrel : D.rel (.fine a) (![p,q])) :
    Structure.Homomorphism.IsEmbeddingOn (action tag) f (P ∪ Q) :=
  hf _ (closed_union D hP hQ) (two_packet_irreducible D hP hQ hp hq a hrel)

end CCO.HKNReservoir
