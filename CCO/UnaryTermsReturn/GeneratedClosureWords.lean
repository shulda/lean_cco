import CCO.UnaryTermsReturn.FullAdmissibleTransfer

/-!
# B052 C13–C15: a generated unary closure is exactly the term-value set

This elementary lemma is intentionally independent of the terminal
hidden signature. For ANY actual family of total unary operations,
the closure generated by one point is the set of values of finite
unary terms (including the empty/identity term), and is the
LEAST functionally closed subset containing that point.

The application to B052 uses the ACTUAL named quotient grammar;
one does not deduce a finite bound for arbitrary partial structures
from the mere finiteness of their unary signature. Only the terminal
actual normal-code result bounds its term values.
-/

universe u v

namespace CCO.UnaryTermsReturn

/-- Finite unary term syntax, with a literal identity and arbitrary
finite composition of the given genuinely interpreted unary symbols.
No finiteness of the set of words is assumed. -/
inductive UnaryClosureWord (U : Type u) : Type u where
  | ident : UnaryClosureWord U
  | thenApply (f : U) (tail : UnaryClosureWord U) : UnaryClosureWord U

namespace UnaryClosureWord

/-- Interpret a unary expression on an ACTUAL carrier with total
unary operations. The empty term denotes real identity, never a
positive STRONG identity atom. -/
def eval {U : Type u} {A : Type v} (action : U → A → A)
    (x : A) : UnaryClosureWord U → A
  | .ident => x
  | .thenApply f tail => action f (eval action x tail)

end UnaryClosureWord

/-- Actual generated unary term values, not an arbitrary set
of vertices satisfying unrelated finite syntactic identities. -/
def unaryClosureValues {U : Type u} {A : Type v}
    (action : U → A → A) (x : A) : Set A :=
  Set.range (UnaryClosureWord.eval action x)

/-- The identity term guarantees the generating point belongs
to its term-value set, independently of unary signature size. -/
theorem unary_closure_values_contains {U : Type u} {A : Type v}
    (action : U → A → A) (x : A) :
    x ∈ unaryClosureValues action x :=
  ⟨.ident, rfl⟩

/-- The set of all term values is truly functionally CLOSED under
every given actual unary symbol. This is the source10 closure
argument by literal term composition, not by a size estimate. -/
theorem unary_closure_values_closed {U : Type u} {A : Type v}
    (action : U → A → A) (x : A)
    (f : U) (y : A) (hy : y ∈ unaryClosureValues action x) :
    action f y ∈ unaryClosureValues action x := by
  obtain ⟨w, rfl⟩ := hy
  exact ⟨.thenApply f w,rfl⟩

/-- Conversely, EVERY functionally closed set containing x
must contain ALL finite unary term values. This proves
minimality and includes expressions of unbounded syntax length.
No HN theorem or hidden hereditary SAP is invoked. -/
theorem unary_closure_values_minimal
    {U : Type u} {A : Type v}
    (action : U → A → A) (x : A) (C : Set A)
    (hx : x ∈ C)
    (hC : ∀ f : U, ∀ y : A, y ∈ C → action f y ∈ C) :
    unaryClosureValues action x ⊆ C := by
  rintro z ⟨w,rfl⟩
  induction w with
  | ident => exact hx
  | thenApply f w ih => exact hC f _ ih

/-- Hence any definition of the one-generated closure as the
LEAST closed set containing x is EXTENSIONALLY IDENTICAL to the
actual set of term values, not merely equinumerous with it.
A uniform finite bound must still be supplied independently. -/
theorem unary_closure_eq_term_values
    {U : Type u} {A : Type v}
    (action : U → A → A) (x : A) (C : Set A)
    (hx : x ∈ C)
    (hC : ∀ f : U, ∀ y : A, y ∈ C → action f y ∈ C)
    (hLeast : ∀ D : Set A, x ∈ D →
      (∀ f : U, ∀ y : A, y ∈ D → action f y ∈ D) →
        C ⊆ D) :
    C = unaryClosureValues action x := by
  apply Set.Subset.antisymm
  · exact hLeast _ (unary_closure_values_contains action x)
      (unary_closure_values_closed action x)
  · exact unary_closure_values_minimal action x C hx hC

end CCO.UnaryTermsReturn
