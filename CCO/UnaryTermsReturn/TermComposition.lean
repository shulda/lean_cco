import CCO.UnaryTermsReturn.RealSourceKernel

/-!
# B052 C26–C27: literal composition and forced named factorisation

The accepted B049 hidden grammar is freely generated by genuinely
interpreted named identities, upward projections and canonical RAW
transport symbols. We construct the *actual syntax* of a composite
word, not merely its semantic graph, and verify evaluation pointwise.

Whenever J <= K are ACTUAL represented proper original FULL
coordinates, the word for the upward projection J→K followed by
ANY named hidden word θ:K→F is itself a legal named term σ:J→F.
Its value at [x]_J is exactly θ([x]_K); no invented source chart,
real-to-hidden inverse, quotient representative or external HN
completion assumption enters the equality.
-/

universe u v w t

namespace CCO.UnaryTermsReturn

variable {ι : Type u} {X : ι → Type v}
variable (S : AtomicSource.{u,v,w} ι X)
variable {G : Type t} [Group G] [∀ i : ι, MulAction G (X i)]

open CCO.TransitionClosure
open CCO.ParityHasse.Original

/-- Compose two ACTUAL named hidden unary words with matching
literal middle coordinate. The constructor recursion retains all
intermediate original sort tags and exact quotient kernels. -/
noncomputable def originalNamedRawUnaryTerm_prepend
    (H : HomogeneousSource S G) (sap : AgeSAP S)
    (nr2 : Selectors.OriginalNR2 S)
    {i j k : ι}
    {D : OriginalNamedHiddenCoordinate S H i}
    {E : OriginalNamedHiddenCoordinate S H j}
    {F : OriginalNamedHiddenCoordinate S H k}
    (first : OriginalNamedRawUnaryTerm S H sap nr2 D E) :
    OriginalNamedRawUnaryTerm S H sap nr2 E F →
      OriginalNamedRawUnaryTerm S H sap nr2 D F
  | .ident _ => first
  | .up second h => .up
      (originalNamedRawUnaryTerm_prepend H sap nr2 first second) h
  | .transition a second => .transition a
      (originalNamedRawUnaryTerm_prepend H sap nr2 first second)

/-- The recursive syntax is not merely extensional in some
unrelated quotient chart: its evaluated function is the LITERAL
composition of the two original named term functions at every
point of the source quotient carrier. -/
theorem originalNamedRawUnaryTerm_prepend_eval
    (H : HomogeneousSource S G) (sap : AgeSAP S)
    (nr2 : Selectors.OriginalNR2 S)
    {i j k : ι}
    {D : OriginalNamedHiddenCoordinate S H i}
    {E : OriginalNamedHiddenCoordinate S H j}
    {F : OriginalNamedHiddenCoordinate S H k}
    (first : OriginalNamedRawUnaryTerm S H sap nr2 D E)
    (second : OriginalNamedRawUnaryTerm S H sap nr2 E F)
    (q : Quotient D.val.val) :
    OriginalNamedRawUnaryTerm.eval S H sap nr2
      (originalNamedRawUnaryTerm_prepend S H sap nr2 first second) q =
    OriginalNamedRawUnaryTerm.eval S H sap nr2 second
      (OriginalNamedRawUnaryTerm.eval S H sap nr2 first q) := by
  induction second with
  | ident E => rfl
  | up second h ih =>
      change Quot.mapRight h
        (OriginalNamedRawUnaryTerm.eval S H sap nr2
          (originalNamedRawUnaryTerm_prepend S H sap nr2 first second) q) =
        Quot.mapRight h
          (OriginalNamedRawUnaryTerm.eval S H sap nr2 second
            (OriginalNamedRawUnaryTerm.eval S H sap nr2 first q))
      rw [ih]
  | transition a second ih =>
      change
        (originalNamedRawTransitionSymbol_transport S H a).quotientEquiv
          (OriginalNamedRawUnaryTerm.eval S H sap nr2
            (originalNamedRawUnaryTerm_prepend S H sap nr2 first second) q) =
        (originalNamedRawTransitionSymbol_transport S H a).quotientEquiv
          (OriginalNamedRawUnaryTerm.eval S H sap nr2 second
            (OriginalNamedRawUnaryTerm.eval S H sap nr2 first q))
      rw [ih]

/-- The existing genuinely named upward term between two
represented source coordinates. It uses only the B049 identity
and upward constructors; no synthetic positive equality atom. -/
def originalNamedUpTerm
    (H : HomogeneousSource S G)
    (sap : AgeSAP S) (nr2 : Selectors.OriginalNR2 S)
    {i : ι} (J K : OriginalNamedHiddenCoordinate S H i)
    (hJK : J.val ≤ K.val) :
    OriginalNamedRawUnaryTerm S H sap nr2 J K :=
  .up (.ident J) hJK

/-- Its actual quotient semantics is literal class projection. -/
theorem originalNamedUpTerm_eval
    (H : HomogeneousSource S G)
    (sap : AgeSAP S) (nr2 : Selectors.OriginalNR2 S)
    {i : ι} (J K : OriginalNamedHiddenCoordinate S H i)
    (hJK : J.val ≤ K.val) (q : Quotient J.val.val) :
    OriginalNamedRawUnaryTerm.eval S H sap nr2
      (originalNamedUpTerm S H sap nr2 J K hJK) q =
        Quot.mapRight hJK q := rfl

/-- An EXPLICIT NAMED term σ:J→F for an already named
quotient-map normal form θ:K→F and the source inclusion J≤K.
This is real syntax: the actual upward term is composed with
the exact θ, preserving all original sort tags and kernels. -/
noncomputable def originalNamedForcedFactor
    (H : HomogeneousSource S G)
    (sap : AgeSAP S) (nr2 : Selectors.OriginalNR2 S)
    {i j : ι}
    (J K : OriginalNamedHiddenCoordinate S H i)
    (F : OriginalNamedHiddenCoordinate S H j)
    (hJK : J.val ≤ K.val)
    (theta : OriginalNamedRawUnaryTerm S H sap nr2 K F) :
    OriginalNamedRawUnaryTerm S H sap nr2 J F :=
  originalNamedRawUnaryTerm_prepend S H sap nr2
    (originalNamedUpTerm S H sap nr2 J K hJK) theta

/-- Literal B052 forced term factorisation, including real input
evaluation. As soon as the source10 normal form produces a
NAMED θ with τ=θ∘F_K, this theorem builds the required named
σ=θ∘u_(J,K) and checks τ=σ∘F_J for EVERY actual old x. -/
theorem originalNamedForcedFactor_eval
    (H : HomogeneousSource S G)
    (sap : AgeSAP S) (nr2 : Selectors.OriginalNR2 S)
    {i j : ι}
    (J K : OriginalNamedHiddenCoordinate S H i)
    (F : OriginalNamedHiddenCoordinate S H j)
    (hJK : J.val ≤ K.val)
    (theta : OriginalNamedRawUnaryTerm S H sap nr2 K F)
    (q : Quotient J.val.val) :
    OriginalNamedRawUnaryTerm.eval S H sap nr2
      (originalNamedForcedFactor S H sap nr2 J K F hJK theta) q =
      OriginalNamedRawUnaryTerm.eval S H sap nr2 theta
        (Quot.mapRight hJK q) := by
  rw [originalNamedForcedFactor, originalNamedRawUnaryTerm_prepend_eval]
  rfl

theorem originalNamedForcedFactor_real_point
    (H : HomogeneousSource S G)
    (sap : AgeSAP S) (nr2 : Selectors.OriginalNR2 S)
    {i j : ι}
    (J K : OriginalNamedHiddenCoordinate S H i)
    (F : OriginalNamedHiddenCoordinate S H j)
    (hJK : J.val ≤ K.val)
    (theta : OriginalNamedRawUnaryTerm S H sap nr2 K F)
    (x : X i) :
    OriginalNamedRawUnaryTerm.eval S H sap nr2 theta
        (Quotient.mk K.val.val x) =
      OriginalNamedRawUnaryTerm.eval S H sap nr2
        (originalNamedForcedFactor S H sap nr2 J K F hJK theta)
        (Quotient.mk J.val.val x) := by
  rw [originalNamedForcedFactor_eval]
  rfl

end CCO.UnaryTermsReturn
