import CCO.StrongExact.ThetaCrossBranchEdges
import Mathlib.Combinatorics.SimpleGraph.Basic

/-!
# C07: the finite uncoloured simple graph underlying hard theta arcs

The graph's adjacency relation is *existence* of a genuine typed
candidate arc on the corresponding ordered pair of distinct formal
vertices. Converse closure makes adjacency symmetric; the actual
diversity letter guarantees irreflexivity. This graph is independent
of the eventual choice of an atomic edge label, and hence may be used
to classify cycles before constructing the coloured B001 diagram.

There is no speculative completion theorem or new semantic premise.
-/

universe u v w

namespace CCO.StrongExact

variable {ι : Type u} {X : ι → Type v}
variable (S : AtomicSource.{u,v,w} ι X)
variable {i j : ι}

/-- Ordinary undirected adjacency generated by the complete list
of genuinely typed positive-word forward/reverse candidate arcs. -/
def thetaAdjacent (ws : List (PositiveWord S i j))
    (x y : thetaVertices S ws) : Prop :=
  ∃ arc : ThetaArc S ws,
    arc ∈ thetaArcs S ws ∧ arc.src = x ∧ arc.dst = y

theorem thetaAdjacent_symmetric
    (ws : List (PositiveWord S i j))
    {x y : thetaVertices S ws} :
    thetaAdjacent S ws x y → thetaAdjacent S ws y x := by
  rintro ⟨arc, ha, hx, hy⟩
  refine ⟨arc.reverse, thetaArcs_reverse_closed S ws arc ha, ?_, ?_⟩
  · change arc.dst = y
    exact hy
  · change arc.src = x
    exact hx

theorem thetaAdjacent_irreflexive
    (ws : List (PositiveWord S i j))
    (x : thetaVertices S ws) :
    ¬ thetaAdjacent S ws x x := by
  rintro ⟨arc, _, hx, hy⟩
  exact arc.ne (hx.trans hy.symm)

/-- Actual finite simple underlying graph, with literal shared roots
and separately indexed interiors. No spurious diagonal is recorded. -/
def thetaSimpleGraph (ws : List (PositiveWord S i j)) :
    SimpleGraph (thetaVertices S ws) where
  Adj := thetaAdjacent S ws
  symm := by
    intro x y h
    exact thetaAdjacent_symmetric S ws h
  loopless := by
    intro x h
    exact thetaAdjacent_irreflexive S ws x h

/-- Every forward original word letter occurs as an undirected theta
edge, without any extra original-source hypothesis. -/
theorem thetaAdjacent_forward
    (ws : List (PositiveWord S i j))
    (b : Fin ws.length) (e : wordEdgeIndex S (ws.get b)) :
    thetaAdjacent S ws
      (thetaBranchEdgeSource S ws b e)
      (thetaBranchEdgeTarget S ws b e) := by
  exact ⟨thetaForwardArc S ws b e,
    thetaForwardArc_mem_theta S ws b e, rfl, rfl⟩

/-- Different branches' private interiors are never adjacent. -/
theorem thetaAdjacent_no_cross_private
    (ws : List (PositiveWord S i j))
    (b c : Fin ws.length) (hbc : b ≠ c)
    (p : wordInterior S (ws.get b))
    (q : wordInterior S (ws.get c)) :
    ¬ thetaAdjacent S ws
      (thetaBranchPosition S ws b p.val)
      (thetaBranchPosition S ws c q.val) := by
  rintro ⟨arc, ha, hs, ht⟩
  exact thetaArc_no_cross_private S ws arc ha b c hbc p q
    ⟨hs,ht⟩

/-- With all words long, neither orientation of a direct old
root-to-root edge belongs to the underlying simple graph. -/
theorem thetaAdjacent_no_root_pair
    (ws : List (PositiveWord S i j))
    (hLong : ∀ a : S.Atom i j,
       (PositiveWord.single a : PositiveWord S i j) ∉ ws) :
    ¬ thetaAdjacent S ws (thetaLeft S ws) (thetaRight S ws) := by
  rintro ⟨arc, ha, hs, ht⟩
  exact thetaArcs_no_root_pair S ws hLong arc ha
    (Or.inl ⟨hs,ht⟩)

end CCO.StrongExact
