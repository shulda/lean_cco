import CCO.TerminalLattice.OriginalQuotientOrbitalReturn
import CCO.Selectors.NR2

/-!
# B051 TNR C10–C11: a nontrivial equivariant quotient involution
# forces an actual ORIGINAL relative-index-two equivalence

The carrier is the ACTUAL quotient X_i/J of the original named sort.
An involution f on that carrier defines an old equivalence K by
  x K y iff [y]_J = [x]_J or [y]_J = f([x]_J).
If f has no fixed points, every K-class consists of exactly TWO
different real J-classes, in the literal RelativeIndexTwo sense.

For a homogeneous original sort, equivariance of f makes K
colour-invariant and transitivity forces any NONIDENTITY f to have
no fixed points. Therefore the local original hypothesis excluding
strict J<K with this index-two interval forces f to be identity.

No quotient SAP, homogeneous quotient theory, automorphism-group
section, FULL NR2 on other cuts, or synthetic STRONG identity.
-/

universe u v w t

namespace CCO.TerminalProfiles

open CCO.ParityHasse.Original
open CCO.TerminalLattice

/-- Literal two-sheet OLD equivalence generated by an involution of
the true J quotient. It includes old J itself as its first sheet. -/
private def quotientInvolutionSetoid
    {A : Type v} (J : Setoid A)
    (f : Quotient J → Quotient J)
    (hf : ∀ q, f (f q) = q) : Setoid A where
  r x y := Quotient.mk J y = Quotient.mk J x ∨
    Quotient.mk J y = f (Quotient.mk J x)
  iseqv := {
    refl := by
      intro x
      exact Or.inl rfl
    symm := by
      intro x y hxy
      rcases hxy with h | h
      · exact Or.inl h.symm
      · right
        calc
          Quotient.mk J x = f (f (Quotient.mk J x)) := (hf _).symm
          _ = f (Quotient.mk J y) := (congrArg f h).symm
    trans := by
      intro x y z hxy hyz
      rcases hxy with hx | hx <;> rcases hyz with hy | hy
      · exact Or.inl (hy.trans hx)
      · exact Or.inr (hy.trans (congrArg f hx))
      · exact Or.inr (hy.trans hx)
      · exact Or.inl (hy.trans ((congrArg f hx).trans (hf _)))
  }

/-- Exactly two real J-classes within every K-class when the quotient
involution is fixed-point free; this is the ORIGINAL local cut guard
used by source09, not a quotient-relative cardinality shortcut. -/
private theorem quotientInvolutionSetoid_relativeIndexTwo
    {A : Type v} (J : Setoid A)
    (f : Quotient J → Quotient J)
    (hf : ∀ q, f (f q) = q)
    (hFree : ∀ q, f q ≠ q) :
    CCO.Selectors.RelativeIndexTwo J
      (quotientInvolutionSetoid (A := A) J f hf) := by
  constructor
  · intro x y hxy
    change Quotient.mk J y = Quotient.mk J x ∨
      Quotient.mk J y = f (Quotient.mk J x)
    exact Or.inl (Quotient.sound (J.symm hxy))
  · intro x
    obtain ⟨y, hy⟩ := Quotient.exists_rep (f (Quotient.mk J x))
    have hxy : Quotient.mk J y = f (Quotient.mk J x) := by
      simpa only [hy]
    have hK : (quotientInvolutionSetoid (A := A) J f hf) x y :=
      Or.inr hxy
    have hNe : ¬ J x y := by
      intro hxyJ
      apply hFree (Quotient.mk J x)
      calc
        f (Quotient.mk J x) = Quotient.mk J y := hxy.symm
        _ = Quotient.mk J x := Quotient.sound (J.symm hxyJ)
    refine ⟨y, hK, hNe, ?_⟩
    intro z
    change (Quotient.mk J z = Quotient.mk J x ∨
        Quotient.mk J z = f (Quotient.mk J x)) ↔
      J x z ∨ J y z
    constructor
    · rintro (h | h)
      · exact Or.inl (Quotient.exact h.symm)
      · exact Or.inr (Quotient.exact (hy.trans h.symm))
    · rintro (h | h)
      · exact Or.inl (Quotient.sound (J.symm h))
      · exact Or.inr ((Quotient.sound (J.symm h)).trans hxy)

/-- SOURCE09 C10–C11, exact ORIGINAL full-cut no-index-two
obstruction for equivariant quotient involutions. The local hypothesis
forbids only an actual strict invariant J<K with [K:J]=2; it does
NOT assume NR2 on unrelated original equivalence intervals.

The quotient G-action is precisely the induced ORIGINAL action.
The proof builds the genuine old full colour-invariant K and
extracts a literal two-sheet RelativeIndexTwo contradiction. -/
theorem original_equivariant_quotient_involution_identity
    {ι : Type u} {X : ι → Type v}
    (S : CCO.AtomicSource.{u,v,w} ι X)
    {G : Type t} [Group G] [∀ i : ι, MulAction G (X i)]
    (H : CCO.HomogeneousSource S G)
    {i : ι} (J : ColourEq S i)
    (hNoTwo : ∀ K : ColourEq S i, J < K →
      ¬ CCO.Selectors.RelativeIndexTwo J.val K.val)
    (f : Quotient J.val → Quotient J.val)
    (hInv : ∀ q, f (f q) = q)
    (hEquiv :
      letI : MulAction G (Quotient J.val) :=
        originalQuotientAction S H J
      ∀ (g : G) (q : Quotient J.val), f (g • q) = g • f q) :
    ∀ q, f q = q := by
  classical
  letI : MulAction G (Quotient J.val) := originalQuotientAction S H J
  by_contra hNoId
  have hMoved : ∃ q : Quotient J.val, f q ≠ q := by
    by_contra hNoMoved
    apply hNoId
    intro q
    by_contra hn
    exact hNoMoved ⟨q, hn⟩
  have hQTrans : ∀ p q : Quotient J.val, ∃ g : G, g • p = q := by
    intro p q
    induction p using Quotient.inductionOn with
    | _ x =>
      induction q using Quotient.inductionOn with
      | _ y =>
        obtain ⟨g, hg⟩ := S.original_sort_transitive_of_homogeneous H i x y
        refine ⟨g, ?_⟩
        simpa only [originalQuotient_mk_smul S H J] using
          congrArg (fun z : X i => Quotient.mk J.val z) hg
  have hFree (q : Quotient J.val) : f q ≠ q := by
    intro hFix
    obtain ⟨p, hMove⟩ := hMoved
    obtain ⟨g, hg⟩ := hQTrans p q
    have hMoveEq : g • f p = g • p := by
      calc
        g • f p = f (g • p) := (hEquiv g p).symm
        _ = f q := by rw [hg]
        _ = q := hFix
        _ = g • p := hg.symm
    exact hMove (MulAction.injective g hMoveEq)
  let Kset : Setoid (X i) := quotientInvolutionSetoid (A := X i) J.val f hInv
  have hKInv : ∀ (g : G) (x y : X i),
      Kset x y → Kset (g • x) (g • y) := by
    intro g x y hxy
    change (Quotient.mk J.val y = Quotient.mk J.val x ∨
      Quotient.mk J.val y = f (Quotient.mk J.val x)) at hxy
    change (Quotient.mk J.val (g • y) = Quotient.mk J.val (g • x) ∨
      Quotient.mk J.val (g • y) = f (Quotient.mk J.val (g • x)))
    rcases hxy with hxy | hxy
    · left
      calc
        Quotient.mk J.val (g • y) = g • Quotient.mk J.val y :=
          (originalQuotient_mk_smul S H J g y).symm
        _ = g • Quotient.mk J.val x := congrArg (fun q => g • q) hxy
        _ = Quotient.mk J.val (g • x) :=
          originalQuotient_mk_smul S H J g x
    · right
      calc
        Quotient.mk J.val (g • y) = g • Quotient.mk J.val y :=
          (originalQuotient_mk_smul S H J g y).symm
        _ = g • f (Quotient.mk J.val x) :=
          congrArg (fun q => g • q) hxy
        _ = f (g • Quotient.mk J.val x) := (hEquiv g _).symm
        _ = f (Quotient.mk J.val (g • x)) :=
          congrArg f (originalQuotient_mk_smul S H J g x)
  let K : ColourEq S i :=
    ⟨Kset, groupInvariant_colourInvariant S H hKInv⟩
  have hJK : J ≤ K := by
    intro x y hxy
    change (Quotient.mk J.val y = Quotient.mk J.val x ∨
      Quotient.mk J.val y = f (Quotient.mk J.val x))
    exact Or.inl (Quotient.sound (J.val.symm hxy))
  have hNotKJ : ¬ K ≤ J := by
    intro hKJ
    obtain ⟨p, hMove⟩ := hMoved
    induction p using Quotient.inductionOn with
    | _ x =>
      obtain ⟨y, hy⟩ := Quotient.exists_rep (f (Quotient.mk J.val x))
      have hK : K x y := by
        change Quotient.mk J.val y = Quotient.mk J.val x ∨
          Quotient.mk J.val y = f (Quotient.mk J.val x)
        exact Or.inr hy
      have hJxy : J x y := hKJ hK
      exact hMove ((Quotient.sound hJxy).trans hy).symm
  have hJKstrict : J < K := lt_of_le_of_ne hJK (by
    intro hEq
    apply hNotKJ
    exact le_of_eq hEq.symm)
  have hTwo : CCO.Selectors.RelativeIndexTwo J.val K.val :=
    quotientInvolutionSetoid_relativeIndexTwo (A := X i) J.val f hInv hFree
  exact hNoTwo K hJKstrict hTwo

end CCO.TerminalProfiles
