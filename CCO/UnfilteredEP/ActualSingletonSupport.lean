import CCO.UnfilteredEP.ActualCoordinates
import CCO.UnfilteredEP.SingletonOrder
import CCO.APRamseyReadout.ActualTupleSupport
import CCO.TypedOrbitFrames.RealBaseClosure

/-!
# The actual singleton full-code support has one value per named sort

A complete selected-coordinate root is generated by one actual real clone.
Its entire unary support is contained in that clone's named closure. The
independent coordinate theorem, with all terminal source premises discharged,
therefore fixes every same-root comparison in the block Ramsey provider.
-/

set_option backward.isDefEq.respectTransparency.types false
set_option synthInstance.maxHeartbeats 250000
set_option maxHeartbeats 900000
universe u v w r p
namespace CCO.UnfilteredEP
open CCO CCO.APRamseyReadout CCO.CloneTupleGeometry
open CCO.TypedOrbitFrames CCO.UnaryTermsReturn CCO.UnaryFreshFrames
open CCO.ParityHasse.Original
noncomputable section

section Source
variable {ι : Type u} {X : ι → Type v}
variable (S : AtomicSource.{u,v,w} ι X)
variable {G : Type r} [Group G] [∀ i, MulAction G (X i)]
variable (H : HomogeneousSource S G) (sap : AgeSAP S)
variable (nr2 : Selectors.OriginalNR2 S)
local notation "M" => originalCompletedStructure S H sap nr2

/-- All term values of one real root with the same named output sort
coincide. In particular nonselected packet partners are covered. -/
theorem actual_real_closure_sort_injective
    (terminal : ∀ (i : ι) (E F : ColourEq S i), E < F →
      ∀ x : X i, Infinite (RelativeClass E.val F.val x))
    {i : ι} (x : X i) :
    Function.Injective (fun y : (M).closureAt (.inl ⟨i,x⟩) => (M).sort y.val) := by
  rintro ⟨y,hy⟩ ⟨z,hz⟩ same
  obtain ⟨a,ha,t,left,hleft⟩ := hy
  change a = .inl ⟨i,x⟩ at ha
  subst a
  obtain ⟨b,hb,s,right,hright⟩ := hz
  change b = .inl ⟨i,x⟩ at hb
  subst b
  have hts : t = s :=
    ((M).eval_sort left rfl).symm.trans
      ((congrArg (M).sort hleft).trans
        (same.trans ((congrArg (M).sort hright).symm.trans ((M).eval_sort right rfl))))
  subst s
  apply Subtype.ext
  have he := congrArg Subtype.val
    (congrFun (actual_real_terms_eq S H sap nr2 terminal left right) x)
  exact hleft.symm.trans (he.trans hright)

end Source

variable (B : OwnerStage.{u,v,w}) (ht : B.Terminal)
variable (F : Charts.{u,v,w,p} B)
local notation "Γ" => actualTupleInterpretation B ht F

/-- Every marked coordinate and every arbitrary term value lies in the
closure of the same original real clone representative. -/
theorem actual_support_subset_single_real_closure
    (A : FiniteInduced (X := B.Point)) (point : Sigma B.Point)
    (singleton : ∀ x : A.vertices, x.val = point) :
    (Γ).support A ⊆ (Hidden B ht).closureAt
      (.inl ⟨point.1,(point.2,0)⟩) := by
  apply (CoordinateTarget B ht).closure_minimal ?_ ?_
  · change (Target B ht).IsClosed ((Hidden B ht).closureAt _)
    exact (CCO.HiddenSAPReadings.partialTarget_closed_iff (Hidden B ht) _).mpr
      ((Hidden B ht).closure_closed _)
  · rintro y ⟨x,j,rfl⟩
    change (ownerRoot B ht F x.val).coordinate j ∈ _
    have hx := singleton x
    rw [← hx]
    rcases x with ⟨⟨i,a⟩,hA⟩
    change namedNode B (chartCoordinate B ht F i j)
      (Quotient.mk (chartCoordinate B ht F i j).val.val (a,0)) ∈ _
    have h := (Hidden B ht).eval_mem_closed
      ((Hidden B ht).closure_closed {(.inl ⟨i,(a,0)⟩ : Values B)})
      (originalProjectionAsTerm (cloneSource B) (HF B) (cloneSAP B)
        (CCO.TerminalHiddenHN.NR2 (cloneSource B) (fullCovers B ht))
        (chartCoordinate B ht F i j))
      ((Hidden B ht).subset_closure {(.inl ⟨i,(a,0)⟩ : Values B)} rfl)
    rw [original_projection_as_term_eval] at h
    exact h

/-- C23–C25 on the actual ANY fixed chart: the entire support of one
visible root has at most one point of each actual named hidden sort. -/
theorem actual_singleton_support_sort_injective
    (A : FiniteInduced (X := B.Point)) (point : Sigma B.Point)
    (singleton : ∀ x : A.vertices, x.val = point) :
    Function.Injective ((Γ).supportStructure A).sort := by
  intro x y same
  let toClosure : (Γ).support A →
      (Hidden B ht).closureAt (.inl ⟨point.1,(point.2,0)⟩) :=
    fun x => ⟨x.val,actual_support_subset_single_real_closure B ht F A point singleton x.property⟩
  have he := actual_real_closure_sort_injective (cloneSource B) (HF B) (cloneSAP B)
    (CCO.TerminalHiddenHN.NR2 (cloneSource B) (fullCovers B ht))
    (fun _ E F hEF a => B.terminal_interval_infinite ht E F hEF a)
    (i := point.1) (point.2,0) (a₁ := toClosure x) (a₂ := toClosure y) same
  apply Subtype.ext
  exact congrArg (fun z : (Hidden B ht).closureAt
    (.inl ⟨point.1,(point.2,0)⟩) => z.val) he

/-- The actual full block-code singleton has exactly one expansion.
This is proved before unary EP, order EP and automatic core are applied. -/
def actual_singleton_block_readout_unique
    (priority : LinearOrder (CoordinateLanguage B ht).Sorts)
    (A : FiniteInduced (X := B.Point)) (point : Sigma B.Point)
    (singleton : ∀ x : A.vertices, x.val = point) :
    Unique ((Γ).BlockReadoutOn priority A) :=
  blockReadout_unique_of_sort_injective (Γ) priority A
    (actual_singleton_support_sort_injective B ht F A point singleton)

end
end CCO.UnfilteredEP
