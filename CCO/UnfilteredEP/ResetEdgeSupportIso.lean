import CCO.UnarySupport.HNDiagrams

/-! Restrict an actual ambient pointed motion to the WHOLE closed
supports of two realized finite pairs. Domain reflection gives equality
of generated images, so the result is surjective on every generated point. -/

universe a b c d
namespace CCO.UnfilteredEP
open CCO.UnarySupport CCO.UnarySupport.Structure
noncomputable section
variable {L : Signature.{a}} {V : Type b} {W : Type c} {U : Type d}
variable {C : Structure L V} {D : Structure L W} {M : Structure L U}

/-- Domain-reflecting induced maps carry the entire generated support
onto the ambient support generated by their images. -/
theorem support_embedding_closure_image (e : C.Embedding D) (S : Set V) :
    e.point '' C.closure S = D.closure (e.point '' S) := by
  apply Set.Subset.antisymm
  · rintro _ ⟨x,hx,rfl⟩
    exact C.closure_minimal
      (S := {x | e.point x ∈ D.closure (e.point '' S)})
      (fun F x hx y hy => D.isClosed_closure _ F _ hx (e.map_func F x y hy))
      (fun x hx => D.subset_closure _ ⟨x,hx,rfl⟩) hx
  · apply D.closure_minimal
    · rintro F _ ⟨x,hx,rfl⟩ y hy
      obtain ⟨z,hz,rfl⟩ := e.reflect_func F x y hy
      exact ⟨z,C.isClosed_closure _ F x hx hz,rfl⟩
    · rintro _ ⟨x,hx,rfl⟩
      exact ⟨x,C.subset_closure _ hx,rfl⟩

theorem support_embedding_func_iff (e : C.Embedding D) (F : L.Func) (x y : V) :
    e.point y ∈ D.func F (e.point x) ↔ y ∈ C.func F x := by
  constructor
  · intro h
    obtain ⟨z,hz,he⟩ := e.reflect_func F x (e.point y) h
    exact e.injective he ▸ hz
  · exact e.map_func F x y

/-- The same ambient automorphism produces a genuine isomorphism of
both whole finite pair closures and fixes the two marked endpoints. -/
theorem realized_support_pair_iso (eC : C.Embedding M) (eD : D.Embedding M)
    (motion : DiagramIso M M) (x y : V) (x' y' : W)
    (hx : motion.equiv (eC.point x) = eD.point x')
    (hy : motion.equiv (eC.point y) = eD.point y') :
    ∃ f : DiagramIso (C.closureStructure {x,y}) (D.closureStructure {x',y'}),
      (∀ z, eD.point (f.equiv z).val = motion.equiv (eC.point z.val)) ∧
      (f.equiv ⟨x,C.subset_closure _ (by simp)⟩).val = x' ∧
      (f.equiv ⟨y,C.subset_closure _ (by simp)⟩).val = y' := by
  have hImage : (motion.equiv ∘ eC.point) '' C.closure {x,y} =
      eD.point '' D.closure {x',y'} := by
    rw [Set.image_comp, support_embedding_closure_image eC]
    change motion.toEmbedding.point '' M.closure (eC.point '' {x,y}) = _
    rw [support_embedding_closure_image motion.toEmbedding, support_embedding_closure_image eD]
    simp only [Set.image_insert_eq,Set.image_singleton]
    change M.closure {motion.equiv (eC.point x),motion.equiv (eC.point y)} = _
    rw [hx,hy]
  have exists_image (z : C.closure {x,y}) :
      ∃ t : D.closure {x',y'}, eD.point t.val = motion.equiv (eC.point z.val) := by
    have hz : motion.equiv (eC.point z.val) ∈ eD.point '' D.closure {x',y'} :=
      hImage ▸ ⟨z.val,z.property,rfl⟩
    obtain ⟨t,ht,he⟩ := hz
    exact ⟨⟨t,ht⟩,he⟩
  let f : C.closure {x,y} → D.closure {x',y'} := fun z => (exists_image z).choose
  have hf (z) : eD.point (f z).val = motion.equiv (eC.point z.val) :=
    (exists_image z).choose_spec
  have finj : Function.Injective f := by
    intro z t he
    apply Subtype.ext
    apply eC.injective
    apply motion.equiv.injective
    exact (hf z).symm.trans ((congrArg (fun r => eD.point r.val) he).trans (hf t))
  have fsurj : Function.Surjective f := by
    intro t
    have ht : eD.point t.val ∈ (motion.equiv ∘ eC.point) '' C.closure {x,y} :=
      hImage.symm ▸ ⟨t.val,t.property,rfl⟩
    obtain ⟨z,hz,he⟩ := ht
    refine ⟨⟨z,hz⟩,Subtype.ext (eD.injective ?_)⟩
    exact (hf _).trans he
  let equiv := Equiv.ofBijective f ⟨finj,fsurj⟩
  have equiv_point (z) : eD.point (equiv z).val = motion.equiv (eC.point z.val) := hf z
  let iso : DiagramIso (C.closureStructure {x,y}) (D.closureStructure {x',y'}) := {
    equiv := equiv
    sort_eq := fun z => (eD.sort_eq _).symm.trans
      ((congrArg M.sort (equiv_point z)).trans ((motion.sort_eq _).trans (eC.sort_eq _)))
    func_iff := by
      intro F z t
      change (equiv t).val ∈ D.func F (equiv z).val ↔ t.val ∈ C.func F z.val
      rw [← support_embedding_func_iff eD, equiv_point,equiv_point,motion.func_iff]
      exact support_embedding_func_iff eC F z.val t.val
    rel_iff := by
      intro R xs
      change D.rel R (fun i => (equiv (xs i)).val) ↔ C.rel R (fun i => (xs i).val)
      have hD := show M.rel R (eD.point ∘ (fun i => (equiv (xs i)).val)) ↔
          D.rel R (fun i => (equiv (xs i)).val) from
        ⟨eD.reflect_rel R _,eD.map_rel R _⟩
      have hp : eD.point ∘ (fun i => (equiv (xs i)).val) =
          motion.equiv ∘ (eC.point ∘ (fun i => (xs i).val)) := funext (fun i => equiv_point (xs i))
      rw [hp,motion.rel_iff] at hD
      exact hD.symm.trans ⟨eC.reflect_rel R _,eC.map_rel R _⟩ }
  refine ⟨iso,equiv_point,eD.injective ?_,eD.injective ?_⟩
  · exact (equiv_point _).trans hx
  · exact (equiv_point _).trans hy

def supportGeneratedEquiv (C : Structure L V) (S : Set V)
    (generated : C.closure S = Set.univ) : V ≃ C.closure S where
  toFun x := ⟨x,generated.symm ▸ Set.mem_univ x⟩
  invFun := Subtype.val
  left_inv _ := rfl
  right_inv _ := rfl

/-- The generated whole objects themselves are isomorphic, without
replacing their carriers by a new support or dropping any old relation. -/
theorem realized_generated_pair_iso (eC : C.Embedding M) (eD : D.Embedding M)
    (motion : DiagramIso M M) (x y : V) (x' y' : W)
    (generatedC : C.closure {x,y} = Set.univ)
    (generatedD : D.closure {x',y'} = Set.univ)
    (hx : motion.equiv (eC.point x) = eD.point x')
    (hy : motion.equiv (eC.point y) = eD.point y') :
    ∃ f : DiagramIso C D,
      (∀ z, eD.point (f.equiv z) = motion.equiv (eC.point z)) ∧
      f.equiv x = x' ∧ f.equiv y = y' := by
  obtain ⟨f,hf,hfx,hfy⟩ := realized_support_pair_iso eC eD motion x y x' y' hx hy
  let left := supportGeneratedEquiv C {x,y} generatedC
  let right := supportGeneratedEquiv D {x',y'} generatedD
  let equiv := (left.trans f.equiv).trans right.symm
  let iso : DiagramIso C D := {
    equiv := equiv
    sort_eq z := f.sort_eq (left z)
    func_iff F z t := f.func_iff F (left z) (left t)
    rel_iff R xs := f.rel_iff R (left ∘ xs) }
  refine ⟨iso,fun z => hf (left z),?_,?_⟩
  · exact hfx
  · exact hfy

end
end CCO.UnfilteredEP
